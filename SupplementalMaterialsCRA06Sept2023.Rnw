\subsection{Validity and two-week test-retest analyses}

Correlations among the key variables/scale scores are shown in the code below.
\begin{scriptsize}
<<Study3.4, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
scoresSubsetStudy3 <- subset(study3datatrimmed, select = c(CRAscoreIRTwave1_score, CRAscoreIRTwave2_score, 
                                                           CRTscores, FFISfrequencyScores, FFISNegEmoValenceScores, 
                                                           FFIScomplexityScores, FFISdirectednessScores))
scoresCorStudy3 <- cor.ci(scoresSubsetStudy3, plot = FALSE)
scoresCorStudy3
@
\end{scriptsize}

Note that the correlations above include the two-week test-retest correlation (\textit{r} $=$ \Sexpr{round(scoresCorStudy3$rho["CRAscoreIRTwave1_score", "CRAscoreIRTwave2_score"],2)}; 95\% empirical CI: [\Sexpr{round(scoresCorStudy3$ci$low.e[1],2)},\Sexpr{round(scoresCorStudy3$ci$up.e[1],2)}]). This association is also shown in Figure \ref{fig:retestCors}.

\begin{scriptsize}
<<Study3.5a, eval=TRUE, echo=FALSE, results='asis', tidy=FALSE, message=FALSE, warning=FALSE>>=
CorPlot <- scoresSubsetStudy3 %>%
  dplyr::filter(!is.na(CRAscoreIRTwave2_score)) %>% 
  ggplot(aes(x = CRAscoreIRTwave1_score, y = CRAscoreIRTwave2_score)) +
  geom_point(color = "dodgerblue4") +
  geom_smooth(method = "lm", formula = y ~ x) +
  labs(x = "Time 1", y = "Time 2", title = "") +
  theme_bw() +
  ggpubr::stat_cor(method = "pearson", p.accuracy = 0.001)
ggsave(filename = paste(wdpath, "figure/retestCors.png", sep=""), scale = 1, width = 5, height = 6, units = c("in"), dpi = 300)


#### Item-level test retest ####

# Creating a new participant variable (Prolific IDs were removed to preserve anonymity)
study3data_retest <- study3data %>%
  dplyr::mutate(participant=rownames(.)) %>%
  relocate(participant)

# Now, because the items were randomly administered, we need to get nested data frames (within participants) to match the "seen_before" questions to the correct CRA item

# Getting data frame with the viewing order for session 1 items 
Viewing_Orders <- study3data_retest %>%
  dplyr::select(participant, contains("MultipleChoice_DO"), -contains("retest")) %>%
  pivot_longer(cols = MultipleChoice_DO_q_14006:MultipleChoice_DO_q_14051,
  names_to = "CRA_Question",
  values_to = "Viewing_Order") %>%
  nest(data = -participant) %>%
  dplyr::mutate(Filtered_Viewing = map(data,
  ~dplyr::filter(., !is.na(Viewing_Order)) %>%
  dplyr::mutate(Viewing_Order =
  as.numeric(Viewing_Order)) %>%
  arrange(Viewing_Order) %>%
  dplyr::mutate(CRA_Question =
  gsub("MultipleChoice_DO_", "", CRA_Question)))) %>%
  dplyr::select(-data)

# Separating out session 2 data
Session_2 <- study3data_retest %>%
  dplyr::select(participant, contains("retest_scored"), contains("Seen_Before"))

# Session 2 CRA items and responses
Session_2_Questions <- Session_2 %>%
  dplyr::select(-contains("Seen")) %>%
  pivot_longer(cols = contains("retest_scored"),
  names_to = "CRA_Question",
  values_to = "Session_2_Response") %>%
  nest(data = -participant) %>%
  dplyr::mutate(Filtered_Session2_Questions = map(data,
  ~dplyr::filter(., !is.na(Session_2_Response)) %>%
  dplyr::mutate(CRA_Question =
  gsub("_retest_scored", "", CRA_Question)))) %>%
  dplyr::select(-data)

# Session 2 "seen before" questions
Seen_Before <- Session_2 %>%
  dplyr::select(participant,
  contains("Seen")) %>%
  pivot_longer(cols = contains("Seen"),
  names_to = "Seen_Question",
  values_to = "Seen_Claimed") %>%
  nest(data = -participant) %>%
  dplyr::mutate(Filtered_Seen_Questions = map(data,
  ~dplyr::mutate(., Seen_Question =
  gsub(".x", "", Seen_Question)))) %>%
  dplyr::select(-data) %>%
  dplyr::mutate(Filtered_Seen_Questions = map(Filtered_Seen_Questions,
  ~dplyr::mutate(., Viewing_Order =
  as.numeric(str_extract(Seen_Question, "(\\d)+"))))) %>%
  dplyr::mutate(Filtered_Seen_Questions = map(Filtered_Seen_Questions,
  ~dplyr::mutate(., Viewing_Order = Viewing_Order*2-1))) %>%
  dplyr::mutate(Filtered_Seen_Questions = map(Filtered_Seen_Questions,
  ~dplyr::mutate(., Seen_Claimed = factor(dplyr::case_when(
  Seen_Claimed == "No" ~ 0, Seen_Claimed == "Yes" ~ 1), levels = c(0,1), labels = c("No", "Yes")))))

# Session 1 responses to CRA items
Session_1 <- study3data_retest %>%
  dplyr::select(participant,
  contains("_scored"), -contains("retest"), -contains("CRT")) %>%
  pivot_longer(cols = contains("scored"),
  names_to = "CRA_Question",
  values_to = "Session_1_Response") %>%
  nest(data = -participant) %>%
  dplyr::mutate(Filtered_Session_1 = map(data,
  ~dplyr::mutate(., CRA_Question =
  gsub("_scored", "", CRA_Question)))) %>%
  dplyr::select(-data)


# Merging the data frames
Full_Nested <- inner_join(Session_1, Session_2_Questions, by = "participant")
Full_Nested <- inner_join(Full_Nested, Seen_Before, by = "participant")
Full_Nested <- inner_join(Full_Nested, Viewing_Orders, by = "participant")
@
\end{scriptsize}

\begin{scriptsize}
<<Study3.5b, eval=TRUE, echo=FALSE, results='hide', tidy=FALSE, message=FALSE, warning=FALSE>>=
# This section of code is hide from the PDF because the results cannot be (readily) compiled without LateX issues.

# Joining nested data frames 
Full_Nested <- Full_Nested %>%
  dplyr::mutate(data = map2(Filtered_Viewing,
                     Filtered_Session_1,
                     inner_join))

Full_Nested <- Full_Nested %>%
  dplyr::mutate(data = map2(data,
                     Filtered_Session2_Questions,
                     inner_join))

Full_Nested <- Full_Nested %>%
  dplyr::mutate(data = map2(data,
                     Filtered_Seen_Questions,
                     inner_join))

Full_Nested <- Full_Nested %>%
  dplyr::mutate(data = map(data,
                    ~mutate(., Actually_Seen = ifelse(!is.na(Session_1_Response), 1, 0)
                    )))


# Unnesting the data
Unnested <- Full_Nested %>%
  dplyr::select(participant, data) %>%
  unnest(cols = c(data))

Unnested <- Unnested %>%
  dplyr::mutate(Seen_num = ifelse(Seen_Claimed == "Yes", 1, 0))


# Running the model with session 1 response and seen before as predictors
Unnested$Session_1_Response <- factor(Unnested$Session_1_Response, labels = c("Incorrect", "Correct"))


trt_model <- glmer(Session_2_Response ~ Session_1_Response + Seen_Claimed + (1 | participant), data = Unnested, family = "binomial")
summary(trt_model)

##### Adding interaction effect ######

trt_model1 <- glmer(Session_2_Response ~ Session_1_Response*Seen_Claimed + (1 | participant), data = Unnested, family = "binomial")
summary(trt_model1)
@
\end{scriptsize}

\begin{scriptsize}
<<Study3.5c, eval=TRUE, echo=FALSE, results='asis', tidy=FALSE, message=FALSE, warning=FALSE>>=
se_trt_model <- sqrt(diag(vcov(trt_model)))
tab_main <- cbind(Est = lme4::fixef(trt_model), 
                  lowerCI = lme4::fixef(trt_model) - 1.96 * se_trt_model, 
                  upperCI = lme4::fixef(trt_model) + 1.96 * se_trt_model)
tab_main <- as.data.frame(tab_main)
tab_main$OR <- exp(tab_main$Est)
tab_main$OR_lowerCI <- exp(tab_main$lowerCI)
tab_main$OR_upperCI <- exp(tab_main$upperCI)

colnames(tab_main) <- c("Estimate", "CI lower", "CI upper", "Odds Ratio", "Odds ratio upper", "Odds ratio lower")
rownames(tab_main) <- c("Intercept", "Response time 1 (Incorrect v Correct)", "Remembered item (No v Yes)")

comment <- list(pos = list(0), command = NULL)
comment$pos[[1]] <- c(nrow(tab_main))
comment$command <- c(paste("\\hline\n",
                          "\\multicolumn{5}{l}{Notes: The estimate values (cols 1-3) are the logistic regression coefficients. CI lower}\\\\\n",
                          "\\multicolumn{5}{l}{and upper represent the bounds of the 95 confidence interval.}\\\\\n",
                          "\\multicolumn{5}{l}{Reference group is an incorrect response to an item that was not remembered.}\\\\\n", sep = ""))

tab_main <- xtable(tab_main, digits=0, caption='Model summary testing the main effects', label='tab:model_trt')
align(tab_main) <- "lcccccc"
digits(tab_main) <- c(0,2,2,2,2,2,2)
print(tab_main, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)


##### Adding interaction effect ######


se_trt_model1 <- sqrt(diag(vcov(trt_model1)))
tab_main1 <- cbind(Est = lme4::fixef(trt_model1), 
                  lowerCI = lme4::fixef(trt_model1) - 1.96 * se_trt_model1, 
                  upperCI = lme4::fixef(trt_model1) + 1.96 * se_trt_model1)
tab_main1 <- as.data.frame(tab_main1)
tab_main1$OR <- exp(tab_main1$Est)
tab_main1$OR_lowerCI <- exp(tab_main1$lowerCI)
tab_main1$OR_upperCI <- exp(tab_main1$upperCI)


colnames(tab_main1) <- c("Estimate", "CI lower", "CI upper", "Odds Ratio", "Odds ratio upper", "Odds ratio lower")
rownames(tab_main1) <- c("Intercept", "Response time 1 (Incorrect v Correct)", "Remembered item (No v Yes)", "Interaction effect")

comment <- list(pos = list(0), command = NULL)
comment$pos[[1]] <- c(nrow(tab_main1))
comment$command <- c(paste("\\hline\n",
                          "\\multicolumn{5}{l}{Notes: The estimate values (cols 1-3) are the logistic regression coefficients. CI lower}\\\\\n",
                          "\\multicolumn{5}{l}{and upper represent the bounds of the 95 confidence interval.}\\\\\n",
                          "\\multicolumn{5}{l}{Reference group is an incorrect response to an item that was not remembered.}\\\\\n", sep = ""))

tab_main1 <- xtable(tab_main1, digits=0, caption='Model summary testing the main effects and interaction effect', label='tab:model_trt1')
align(tab_main1) <- "lcccccc"
digits(tab_main1) <- c(0,2,2,2,2,2,2)
print(tab_main1, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)

@
\end{scriptsize}

\begin{scriptsize}
<<Study3.5d, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
# Comparing models
anova(trt_model, trt_model1)
@
\end{scriptsize}

\begin{figure}
\ffigbox{\includegraphics[width=.65\textwidth]{figure/retestCors.png}}{\caption{Test-retest reliability over two weeks}\label{fig:retestCors}}
\end{figure}


\section{Study 4}

\subsection{Dimensionality and IRT analyses of the combined CRA item sets}

The aim of Study 4 is to identify the IRT calibrations of a larger item set for use when administering the CRA with multiple choice response options in the future. The method matches the same procedures used in Study 1, however the item pool is expanded. Here, we generate calibrations for a set that combines the ``new'' CRA items and the multiple-choice version of the CRAT items from Study 1 (87 in total, after removing the problematic items), plus multiple-choice versions of an additional 80 items commonly used as open-ended items in CRA-related research (based on personal correspondence with Mark Beeman). Thus, \textbf{there are a total of 167 items in the combined CRA item pool reported on here}.

Of the 80 new items that we not previously used in Studies 1 or 2, 49 are part of the 144-item set described in \citet{Bowden:2003CRAT} (these items are numbered q\textunderscore 14327 through q\textunderscore 14404, with many of the chronological item numbers excluded), and the remaining 31 items were algorithmically generated using the procedures described in Study 1. These 31 items have not previously been published, and are numbered q\textunderscore 14434 through q\textunderscore 14466. Note that items q\textunderscore 14442 and q\textunderscore 14437 were deprecated due to having an aberrantly low difficulty and discrimination values, respectively.

In the code version of this file (see the .Rnw), we begin by wrangling the data as follows: (1) loading this larger data file that overlaps with the one used in Study 1, (2) removing the items identified as problematic in Study 1 (2 items from the new 67-item set of the CRA and 8 from the older 30-item CRAT set), (3) removing the two items mentioned above, and (4) generating descriptive statistics.

\begin{scriptsize}
<<Study4.1, eval=TRUE, echo=FALSE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>=
rm(list=ls()[!(ls() %in% c('findcolnumber', 'keys.list', 'wdpath', 'score_ICAR_IRT', 'CRAitemNumbersStudy1'))])
load(paste(wdpath, "data/study1/CRAdataStudy1version1.rdata", sep = ""))
#load("OnlineSupplement/data/study1/CRAdataStudy1version1.rdata")

endDate <- substr(max(CRAitemData$servertime), 1, 10)
midDate <- "2022-06-25"
lengthDays <- difftime(endDate, midDate, units = "days")

CRAitemSetAll <- subset(CRAitemData, select = c(q_14003:q_14466))
dim(CRAitemSetAll)

# Recall that two items were dropped from the new CRA item set...
CRAitemSetAll <- subset(CRAitemSetAll, select = -c(q_14043, q_14023))
dim(CRAitemSetAll)

# And several others were dropped from the CRAT item set...
CRAitemSetAll <- subset(CRAitemSetAll, select = -c(q_14317, q_14307, q_14318, q_14310, q_14308, q_14315, q_14298, q_14299))
dim(CRAitemSetAll)

# And three more were dropped due to having aberrantly low diff (14442) or disc (14437, 14364).
CRAitemSetAll <- subset(CRAitemSetAll, select = -c(q_14442, q_14437, q_14364))
dim(CRAitemSetAll)

CRAitemSet167 <- CRAitemSetAll
rm(CRAitemSetAll, CRAitemData)
gc()

descCRAitems167 <- psych::describe(CRAitemSet167)
totalSampleSize <- describe(descCRAitems167$n)

CRAitemNumbers167 <- colnames(CRAitemSet167)
CRAitemContent167 <- CRAitemContent[CRAitemNumbers167,]
rm(CRAitemContent)
gc()

descCRAitemssorted167 <- descCRAitems167[with(descCRAitems167, order(-mean)),]

pwiseAdminsCRAitems167 <- pairwiseCount(CRAitemSet167, diagonal = TRUE)
pwiseAdminsCRAitems167Vec <- as.vector(pwiseAdminsCRAitems167[lower.tri(pwiseAdminsCRAitems167)])
pwiseAdminsCRAitems167Describe <- psych::describe(pwiseAdminsCRAitems167Vec)
n_obs167 <- pwiseAdminsCRAitems167Describe$mean

# Get the descriptive statistics for the pairwise administration counts
pwiseAdminsCRAitems167Describe

@
\end{scriptsize}

The resulting data frame includes \Sexpr{dim(CRAitemSet167)[2]} CRA items and \Sexpr{prettyNum(dim(CRAitemSet167)[1], big.mark=",", scientific=F)} participants. With respect to the overlapping nature of these data relative to Study 1, note that the Study 1 data were collected between 2017-02-07 and 2022-06-25. Here, we have added to those data by administering items more intensively from the larger item pool. Thus the data collection in this sample ran from 2017-02-07 to \Sexpr{endDate}. Over much of this interval, a small number of items were given from about half of the item pool (i.e., the data from Study 1), but a larger number of items were given from a larger item pool over the last \Sexpr{round(as.numeric(lengthDays),0)} days. We use all available data to maximize our sample size --- this is particularly important when identifying the IRT parameters.

The total number of administrations per item ranged from \Sexpr{prettyNum(totalSampleSize$min, big.mark=",", scientific=F)} to \Sexpr{prettyNum(totalSampleSize$max, big.mark=",", scientific=F)} (\textit{m} = \Sexpr{prettyNum(round(totalSampleSize$mean,1), big.mark=",", scientific=F)}; \textit{Mdn} = \Sexpr{prettyNum(totalSampleSize$median, big.mark=",", scientific=F)}; \textit{sd} = \Sexpr{prettyNum(round(totalSampleSize$sd,1), big.mark=",", scientific=F)}). The pairwise administration counts ranged from \Sexpr{prettyNum(pwiseAdminsCRAitems167Describe$min, big.mark=",", scientific=F)} to \Sexpr{prettyNum(pwiseAdminsCRAitems167Describe$max, big.mark=",", scientific=F)} (\textit{m} = \Sexpr{prettyNum(round(pwiseAdminsCRAitems167Describe$mean,1), big.mark=",", scientific=F)}; \textit{Mdn} = \Sexpr{prettyNum(pwiseAdminsCRAitems167Describe$median, big.mark=",", scientific=F)}; \textit{sd} = \Sexpr{prettyNum(round(pwiseAdminsCRAitems167Describe$sd,1), big.mark=",", scientific=F)}). In the next chunk, we identify the item-level correlation matrix (tetrachoric) and evaluate the unidimensionality.

\begin{scriptsize}
<<Study4.2, eval=TRUE, echo=TRUE, results='markup', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>=
tetchor_matrix167 <- suppressWarnings(tetrachoric(CRAitemSet167, smooth = TRUE))

cor_matrix167 <- tetchor_matrix167$rho

omega_results167 <- suppressWarnings(psych::omega(cor_matrix167, plot = FALSE))
omega.h167 <- round(omega_results167$omega_h,2)
omega.alpha167 <- round(omega_results167$alpha,2)
omega.t167 <- round(omega_results167$omega.tot,2)
@
\end{scriptsize}

The items have high internal consistency in this data set ($\alpha$ = \Sexpr{omega.alpha167}; $\omega_{t}$ = \Sexpr{omega.t167}). Similarly, the omega general value ($\omega_{h}$ = \Sexpr{omega.h167}) suggests strong unidimensionality. To help visualize this, we plot the correlations among items after they have been sorted by factor loading (code not shown), with a one factor model specified (sorting by factor loading is only done to organize the presentation of items). We also extract the empirically-observed confidence intervals around the tetrachoric correlations here (also not shown; see the Rnw version). 

\begin{scriptsize}
<<Study4.3, eval=TRUE, echo=FALSE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
CRA_fa167 <- suppressMessages(suppressWarnings(fa(cor_matrix167, nfactors = 1)))
CRA_fa_sort167 <- fa.sort(CRA_fa167)
rows_CRA167 <- rownames(CRA_fa_sort167$loadings)

cor_matrix167_plot <- cor_matrix167[rows_CRA167, rows_CRA167]

avg_cor_value167 <- mean(cor_matrix167)
min_cor_value167 <- min(cor_matrix167)

CIs167 <- corCi(cor_matrix167, n.iter=1000, n=n_obs167)
CIs167 <- as.data.frame(CIs167$r.ci)
CIs167$range <- CIs167$upper-CIs167$lower
CIs167$sig <- ifelse(CIs167$range > CIs167$upper, 0, 1)
CIs167$sigNeg <- ifelse(CIs167$upper < 0, 1, 0)

maxCI167 <- max(CIs167$range)
minCI167 <- min(CIs167$range)
meanCI167 <- mean(CIs167$range)
overlappingZero167 <- nrow(CIs167)-sum(CIs167$sig)
sigNeg167 <- sum(CIs167$sigNeg)

# get the IRT model of the response data
IRT_model167 <- suppressWarnings(mirt(CRAitemSet167, 1, itemtype = "2PL", constrain = NULL, technical = list(NCYCLES=2000)))


#M2(IRT_model167, na.rm = TRUE)

@
\end{scriptsize}

\begin{scriptsize}
<<Study4.4, eval=TRUE, echo=FALSE, results='hide', tidy=FALSE, message=FALSE, warning=FALSE>>=
file_path = paste(wdpath, "figure/singlefactorcors167.png", sep = "")
png(height=1800, width=1800, file=file_path, type = "cairo")
corrplot(cor_matrix167_plot, method = "color", tl.col = "black",
         bg = "White", tl.srt = 0, type = "full", title = "",
         col = COL2('RdBu',200), tl.pos = 'n')
dev.off()

file_path= paste(wdpath, "figure/singlefactorcors167.eps", sep="")
setEPS()
postscript(height=200, width=200, file=file_path)
corrplot(cor_matrix167_plot, method = "color", tl.col = "black",
         bg = "White", tl.srt = 0, type = "full", title = "",
         col = COL2('RdBu',200), tl.pos = 'n')
dev.off()

@
\end{scriptsize}

The correlations are shown in Figure \ref{fig:singlefactorcors167}. The plot provides evidence of a clear general factor, though there are a small number of correlations between items with point estimates below 0 --- as low as \Sexpr{round(min_cor_value167,3)} --- indicated with pale red tones in the lower right corner of the figure (average overall \textit{r} = \Sexpr{round(avg_cor_value167,2)}). The range of the 95\% confidence intervals around these correlations (i.e., the range from the high to low end of the confidence interval) had a mean of \Sexpr{round(meanCI167,2)} (minimum $=$ \Sexpr{round(minCI167,2)} and maximum = \Sexpr{round(maxCI167,2)}). Of the \Sexpr{prettyNum(((167*167-167)/2), big.mark=",", scientific=F)} pairwise correlations, \Sexpr{overlappingZero167} had confidence intervals overlapping with zero; only \Sexpr{sigNeg167} of the remaining \Sexpr{prettyNum(((167*167-167)/2)-overlappingZero167, big.mark=",", scientific=F)} had point estimates \textit{and} confidence intervals below 0.

\begin{figure}
\ffigbox{\includegraphics[width=.75\textwidth]{figure/singlefactorcors167.png}}{\caption{Correlations among 167 multiple choice CRA items sorted by general factor loadings.}\label{fig:singlefactorcors167}}
\end{figure}

\subsection{Identify the IRT parameters for the full CRA item bank}

The next step is to extract and table the IRT parameters for the full item bank, then plot the item characteristic curves (for all items separately and together) and test information functions. The code for these steps is left out of the PDF version of this file (see the Rnw for full details). Table \ref{tab:parameters167} shows the items and parameters. This includes coefficients for the item difficulties (the location of the 50/50 probability of a correct response) and discrimination parameters (the slopes), as well as the mean proportion of correct responses and the standard error of the means.

\begin{scriptsize}
<<Study4.5, eval=TRUE, echo=FALSE, results='asis', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
# table the item parameters
# note that you must specify IRTpars=TRUE to get difficulties instead of easiness
IRT_model_parameters167 <- coef(IRT_model167, IRTpars=TRUE, simplify = TRUE)
marginalReliability167 <- marginal_rxx(IRT_model167)
marginalReliability167

CRAparameters167 <- IRT_model_parameters167$items[,1:2]
CRAparameters167 <- data.frame(CRAparameters167, descCRAitemssorted167$mean, descCRAitemssorted167$se, descCRAitemssorted167$n)
colnames(CRAparameters167) <- c("discrimination", "difficulty", "mean", "se", "n")

CRA167parametersSortedByDisc <- CRAparameters167[order(CRAparameters167[,"discrimination"]),]
CRA167parametersSortedByDiff <- CRAparameters167[order(CRAparameters167[,"difficulty"]),]
CRA167parametersSortedByMean <- CRAparameters167[order(CRAparameters167[,"mean"]),]
lowDisc <- subset(CRA167parametersSortedByDisc, CRA167parametersSortedByDisc$discrimination<.6)

# make table of item content and parameters
CRAitemContent167v2 <- CRAitemContent167[rownames(CRAparameters167),c("prompt1", "prompt2", "prompt3", "stem")]
colnames(CRAitemContent167v2) <- c("Stimuli 1", "Stimuli 2", "Stimuli 3", "Solution")
CRAparameters167v2 <- cbind(CRAitemContent167v2, CRAparameters167)


# IRT model fit
# model_fit167 <- M2(IRT_model167, na.rm = TRUE)


@
\end{scriptsize}

\begin{scriptsize}
<<Study4.6, eval=TRUE, echo=FALSE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>=
# plot the item characteristic curves for all items separately and together

file_path = paste(wdpath, "figure/ICCs167.png", sep = "")
png(height=600, width=600, file=file_path, type = "cairo")
plot(IRT_model167, type = 'trace', facet_items = TRUE)
dev.off()

file_path= paste(wdpath, "figure/ICCs167.eps", sep="")
setEPS()
postscript(height=100, width=100, file=file_path)
plot(IRT_model167, type = 'trace', facet_items = TRUE)
dev.off()

file_path = paste(wdpath, "figure/ICCscombined167.png", sep = "")
png(height=600, width=600, file=file_path, type = "cairo")
plot(IRT_model167, type = 'trace', facet_items = FALSE, auto.key = FALSE)
dev.off()

file_path= paste(wdpath, "figure/ICCscombined167.eps", sep="")
setEPS()
postscript(height=100, width=100, file=file_path)
plot(IRT_model167, type = 'trace', facet_items = TRUE)
dev.off()

# plot the test information function with the standard error

file_path = paste(wdpath, "figure/irttestfunction167.png", sep = "")
png(height=600, width=600, file=file_path, type = "cairo")
plot(IRT_model167, type = "infoSE", xlim = c(-3,3)) #test score function
dev.off()

file_path= paste(wdpath, "figure/irttestfunction167.eps", sep="")
setEPS()
postscript(height=100, width=100, file=file_path)
plot(IRT_model167, type = "infoSE", xlim = c(-3,3)) #test score function
dev.off()

file_path = paste(wdpath, "figure/IRTtwofiguresFullBank.png", sep = "")
png(height=600, width=1200, file=file_path, type = "cairo")
plot3 <- plot(IRT_model167, type = "infoSE", xlim = c(-3,3)) #test score function
plot4 <- plot(IRT_model167, type = 'trace', facet_items = FALSE, auto.key = FALSE)
grid.arrange(plot3, plot4, ncol=2)
dev.off()

@
\end{scriptsize}

\begin{figure}
\ffigbox{\includegraphics[width=.75\textwidth]{figure/ICCscombined167.png}}{\caption{Item probability functions for all of the CRA items together.}\label{fig:ICCscombined167}}
\end{figure}

\begin{figure}
\ffigbox{\includegraphics[width=.95\textwidth]{figure/ICCs167.png}}{\caption{Item probability functions for all of the CRA items.}\label{fig:ICCs167}}
\end{figure}

Figure \ref{fig:ICCscombined167} shows the probability functions for all the items together in one plot, and Figure \ref{fig:ICCs167} shows the probability functions for all 167 items separately. Figure \ref{fig:ICCscombined167} indicates that most items have difficulties greater than zero (\textit{m} = \Sexpr{round(mean(CRA167parametersSortedByDisc[,"difficulty"]),2)}; \textit{Mdn} = \Sexpr{round(median(CRA167parametersSortedByDisc[,"difficulty"]),2)}). Difficulty values reflect the location of the intercept where the probabilities of correct and incorrect responses are equal. Only \Sexpr{length(CRA167parametersSortedByDiff$difficulty[CRA167parametersSortedByDiff$difficulty<0])} of the 167 items have difficulty coefficients below zero, and this indicates that most items are somewhat difficult for most respondents. Given the content of these items, moderately high difficulties are desirable, but items with excessively high difficulty would not be particularly useful as there will be little variance across respondents (i.e., because nearly all respondents fail to identify the correct answer).

Figures \ref{fig:ICCscombined167} and \ref{fig:ICCs167} also show that most of the items are adequately discriminant (\textit{m} = \Sexpr{round(mean(CRA167parametersSortedByDisc[,"discrimination"]),2)}; \textit{Mdn} = \Sexpr{round(median(CRA167parametersSortedByDisc[,"discrimination"]),2)}), though there are a few exceptions. This implies that the items are able to discriminate well between individuals with relatively similar levels of associative ability around the difficulty intercept, as a small increase in associative ability in this range substantially increases the probability of correct responding. This is depicted visually by the slope of the item probability functions. Of the 167 items, only \Sexpr{length(CRA167parametersSortedByDisc$discrimination[CRA167parametersSortedByDisc$discrimination<.6])} have discrimination parameters below .6 and above .5, a value that is commonly deemed a lower bound of acceptability \citep{An:2014, Debeer:2013}. Note that it may also be reasonable to drop a few other items with relatively low discriminations, but there is a case to be made for keeping items that cover a wide range of discriminations, especially if they are all above an acceptable threshold \citep{Cheng:2015}. This argument mainly rests on the increased flexibility provided by a diverse item set for computer adaptive testing applications.

Figure \ref{fig:irttestfunction167} shows the joint information for the final set of CRA items across the range of difficulty along with the standard error. As the standard error is akin to the inverse of reliability (more specifically, reliability is 1 minus the square of the standard error over the standard deviation), Figure \ref{fig:irttestfunction167} indicates that the test is particularly reliable from the range of difficulty of about -0.5 sd to +3 sd. The marginal reliability across all respondents in these data is high at \Sexpr{round(marginalReliability167,2)} \citep{Thissen:2001}.

The parameters for the (2PL) IRT model for the full item bank --- shown in Table \ref{tab:parameters167} --- are posted for use by others OSF with the rest of the materials for this project; see \href{tinyurl.com/2a8vx6n8}{tinyurl.com/2a8vx6n8}.

\begin{figure}
\ffigbox{\includegraphics[width=.75\textwidth]{figure/irttestfunction167.png}}{\caption{Test information (blue) and standard error (red) functions for the complete CRA item pool.}\label{fig:irttestfunction167}}
\end{figure}

\clearpage

\begin{scriptsize}
<<Study4.7, eval=TRUE, echo=FALSE, results='asis', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
