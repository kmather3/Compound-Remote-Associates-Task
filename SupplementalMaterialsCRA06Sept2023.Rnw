\begin{scriptsize}
<<Study1.24, eval=TRUE, echo=FALSE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
rm(list=ls()[!(ls() %in% c('CRAvalidityData', 'findcolnumber', 'itemsToDrop67', 'keys.list', 'wdpath', 'CRAitemNumbersStudy1', 'score_ICAR_IRT'))])
colnames(CRAvalidityData)[c(findcolnumber(CRAvalidityData, "CRA new items"))] <- "CRA"

# Start by prepping the data, getting avg CRA score by job.
CRA_data <- CRAvalidityData %>%
            group_by(occupation) %>%
            dplyr::summarise(CRA_Score = mean(CRA, na.rm = TRUE),
            n = length(!is.na(CRA)))

# Drop occupations with less than 100 people
CRA_data <- CRA_data %>%
            dplyr::filter(n>=100) %>%
            mutate('SAPA.Job.Title' = occupation)

# Load the onet_characteristics_by_job
onet_data <- import(paste(wdpath, "data/study1/onet/onet_char.csv", sep = ""))

# Evaluate the correlations among O*NET job characteristics
onet_data_cor <- cor(onet_data, use = "pairwise")

# Note that the correlations between "importance" and "level" characteristics tend to be
# very high (>.85). For example:
round(onet_data_cor[c(4,5),c(4,5)],2)
round(onet_data_cor[c(6,7),c(6,7)],2)
round(onet_data_cor[c(9,10),c(9,10)],2)

# The correlations were less than .8 in only 3 importance/level pairs. These are:
round(onet_data_cor[c("Getting_Information_Imp","Getting_Information_Level"),
                    c("Getting_Information_Imp","Getting_Information_Level")],2)
round(onet_data_cor[c("Identifying_Objects_Actions_and_Events_Imp",
                      "Identifying_Objects_Actions_and_Events_Level"),
                    c("Identifying_Objects_Actions_and_Events_Imp", 
                      "Identifying_Objects_Actions_and_Events_Level")],2)
round(onet_data_cor[c("Selective_Attention_Imp","Selective_Attention_Level"),
                    c("Selective_Attention_Imp","Selective_Attention_Level")],2)

# So we drop the "level" job characteristics to prevent multicollinearity
onet_data_no_redund <- onet_data %>% dplyr::select(-ends_with("_Level"))
# In doing so, we reduce the total number of characteristics to be evaluated
# number of characteristics before:
dim(onet_data)
# number of characteristics  after:
dim(onet_data_no_redund)
# number of characteristics dropped:
dim(onet_data)[2]-dim(onet_data_no_redund)[2]

# Then we import the file containing codings of the job characteristics. These include codings 
# of the characteristics as either psychological or physical in nature (used further down), 
# as well as codings of highly redundant pairs (beyond the "level" and "importance" distinction handled above).
codings <- import(paste(wdpath, "data/study1/onet/onet_varnames_char_types.csv", sep = ""))

# The highly redundant pairs (r>.9) were identified based on discussion among coders (DMC & BH)
varsToDrop <- codings %>% dplyr::filter(drop == "1") # This removes 7 additional items
# Show the characteristics to be dropped:
varsToDrop[,1]

# Now drop them (the corresponding ``level'' characteristics were already dropped above)
onet_data_no_redund <- onet_data_no_redund[, !names(onet_data_no_redund) %in% varsToDrop$char_name]
dim(onet_data_no_redund)

# Load the occupational ratings by job
CrosswalkTable <- suppressWarnings(read.csv(paste(wdpath, "data/study1/onet/PrestigeRtgsCrosswalk28apr2021.csv", sep=""),
                                            header=TRUE))

# Clean them up and map them to the CRA data
CrosswalkTable$O.NET.SOC.2010.Code <- str_replace_all(CrosswalkTable$O.NET.SOC.2010.Code, "[^[:alnum:]]", "")

CRA_OPR <- inner_join(CRA_data, CrosswalkTable, by = "SAPA.Job.Title")
colnames(CRA_OPR)[c(findcolnumber(CRA_OPR, "O.NET.SOC.2010.Code"))] <- "occ_code"
CRA_OPR$occ_code <- as.numeric(CRA_OPR$occ_code)
CRA_OPR <- subset(CRA_OPR, select = c(occ_code, occupation, CRA_Score, n, SAPA.Job.Title, OPR.Jobs.2016))
colnames(CRA_OPR)[c(findcolnumber(CRA_OPR, "OPR.Jobs.2016"))] <- "Occupational_Prestige"

CRA_OPR_onet <- left_join(onet_data_no_redund, CRA_OPR, by = "occ_code")
# remove duplicated rows
CRA_OPR_onet <- CRA_OPR_onet %>% distinct()

# Edit the _Imp labels for easier reading and table production
names(CRA_OPR_onet) = gsub("_Imp", "", names(CRA_OPR_onet))
@
\end{scriptsize}

\begin{scriptsize}
<<Study1.25, eval=TRUE, echo=TRUE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
bs_all <- bestScales(CRA_OPR_onet[,c(2:ncol(CRA_OPR_onet))], criteria = cs(CRA_Score), 
           cut = .0, n.item = 100, n.iter = 1000, 
           overlap = FALSE, check = TRUE, impute = "none", digits = 2) 

bs_all_df <- as.data.frame(bs_all$items$CRA_Score)
least <- bs_all_df[order(bs_all_df$mean.r),][1:40,]
most <- bs_all_df[order(-bs_all_df$mean.r),][1:40,]

@
\end{scriptsize}

\begin{scriptsize}
<<Study1.26, eval=TRUE, echo=FALSE, results='asis', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
comment <- list(pos = list(0), command = NULL)
comment$pos[[1]] <- c(nrow(most))
comment$command <- c(paste("\\hline\n", sep = ""))

mostTable <- xtable(most, digits=0, caption='Job characteristics sorted by association with CRA scores (top 40)',
                    label='tab:most')
align(mostTable) <- "lrrr"
digits(mostTable) <- c(0,0,2,2)
print(mostTable, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)

leastTable <- xtable(least, digits=0, caption='Job characteristics sorted by association with CRA scores (bottom 40)',
                     label='tab:least')
align(leastTable) <- "lrrr"
digits(leastTable) <- c(0,0,2,2)
print(leastTable, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)
@
\end{scriptsize}

Tables \ref{tab:majors10} and \ref{tab:occupations10} show the university majors and jobs, respectively, that are most and least associated with scores on the new CRA items among respondents who gave information about their majors and jobs. Both tables are sorted in descending order by CRA percentile, and the tables show ICAR percentile scores for 6 additional cognitive ability domains (Letter-Number Series, Matrix Reasoning, Three Dimensional Rotation, Verbal Reasoning, Figural Analogies, and Propositional Reasoning). For the majors, most of the top 10 were majors that draw heavily on language skills and, presumably, strong vocabularies. The same theme was present for the occupations as well, though there was a slightly broader representation of jobs involving a high general level of education, including 3 university faculty jobs, physicists, and economists in addition to editors, writers, and librarians.

Tables \ref{tab:most} and \ref{tab:least} show the O*NET job characteristics that are most and least, respectively, associated with scores on the new CRA items among respondents who gave information about their jobs. As described in the main manuscript, the job characteristics are collected by O*NET directly; the analyses are based on the BISCUIT technique \citep{Elleman:2020} using 1,000 bootstrapped iterations. Here again, the job characteristics most highly associated with CRA scores include strong language skills, especially reading and writing. The job characteristics least associated with CRA scores are entirely represented by physical tasks unrelated to communication and language.

\section{Study 2}

The aim of Study 2 was to validate the new CRA item set from Study 1 in a student sample relative to academic achievement measures, and to evaluate the effects of response format (open-ended vs multiple-choice) and item type (CRAT vs new CRA items). Data were collected from an undergraduate sample at \textbf{[blinded for review]}, starting on September 30, 2020 and ending on March 21, 2021. These data are available on OSF (\href{tinyurl.com/2a8vx6n8}{tinyurl.com/2a8vx6n8}) in a file labeled 'Study2data.csv'. In the subsections below, we describe the steps for loading and cleaning the data, and carrying out the planned analyses.

\subsection{Data wrangling}

Begin by loading, cleaning, and scoring the data. Note that the data have already been de-identified, and that responses to the individual items have already been scored as correct (1) or incorrect (0). Half of the items were given using an open-response format, and these were coded manually by the first author. As the respondents were undergraduates participating for course credit, they were given the option of not responding. Items that were skipped or marked as ``I don't know'' were scored as incorrect.

To score the items, two approaches are used. For the open-ended response format, we used sum/mean scores, scoring separately for the new CRA item content and for the existing CRAT content. For the multiple choice response format, we used sum/mean scores and IRT scoring based on the item calibrations identified in Study 1. This meant that some items were dropped due to psychometric properties, as described in Study 1. Note also that two of the items administered in Study 1 were missing from this data set: item q\_14012 was omitted from data collection due to a coding error and item q\_14125 was used as an example item in this data collection.

\begin{scriptsize}
<<Study2.1, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
rm(list=ls()[!(ls() %in% c('findcolnumber', 'keys.list', 'wdpath', 'score_ICAR_IRT', 'CRAitemNumbersStudy1'))])

# Load the de-identified data file. The raw data file has been cleaned to 
# remove identifying data that is automatically collected by Qualtrics.
study2data <- read.csv(paste(wdpath, "data/study2/study2data.csv", sep=""), header=TRUE)
#study2data <- read.csv("OnlineSupplement/data/study2/study2data.csv", header=TRUE)

# Drop participants who self-report low English-language fluency
study2data <- study2data[study2data$English_Fluency != "Not well", ]

# Get the sum scores for the open-ended response format for the new CRA item content
study2data$meanScore_CRAopen <- rowMeans(study2data[,c(findcolnumber(study2data, "q_14003_CRA_open1scored"):
                                                  findcolnumber(study2data, "q_14197_CRA_open65scored"))],
                                                  na.rm = TRUE)
# Get the sum scores for the open-ended response format for the older CRAT items
study2data$meanScore_CRATopen <- rowMeans(study2data[,c(findcolnumber(study2data, "q_14289_CRAT_open1scored"):
                                                  findcolnumber(study2data, "q_14318_CRAT_open30scored"))],
                                                  na.rm = TRUE)
# Get the sum scores for the multiple choice response format for the new CRA item content
study2data$meanScore_CRA_MC <- rowMeans(study2data[,c(findcolnumber(study2data, "q_14003_CRA_MC1scored"):
                                                  findcolnumber(study2data, "q_14197_CRA_MC65scored"))],
                                                  na.rm = TRUE)
# Get the sum scores for the multiple choice response format for the older CRAT items
study2data$meanScore_CRAT_MC <- rowMeans(study2data[,c(findcolnumber(study2data, "q_14289_CRAT_MC1scored"):
                                                  findcolnumber(study2data, "q_14318_CRAT_MC30scored"))],
                                                  na.rm = TRUE)

# Getting alpha and omega for each 

# CRA open 
tetrachor_CRAopen <- suppressWarnings(tetrachoric(study2data[,c(findcolnumber(study2data, "q_14003_CRA_open1scored"):
        findcolnumber(study2data, "q_14197_CRA_open65scored"))], smooth = TRUE))

tetrachor_CRAopen <- tetrachor_CRAopen$rho
omega_CRAopen <- suppressWarnings(psych::omega(tetrachor_CRAopen, plot = FALSE))
round(omega_CRAopen$alpha,2)
round(omega_CRAopen$omega.tot,2)


# CRAT open
tetrachor_CRATopen <- suppressWarnings(tetrachoric(study2data[,c(findcolnumber(study2data, "q_14289_CRAT_open1scored"):
    findcolnumber(study2data, "q_14318_CRAT_open30scored"))], smooth = TRUE))

tetrachor_CRATopen <- tetrachor_CRATopen$rho
omega_CRATopen <- suppressWarnings(psych::omega(tetrachor_CRATopen, plot = FALSE))
round(omega_CRATopen$alpha,2)
round(omega_CRATopen$omega.tot,2)


# CRA multiple-choice
tetrachor_CRAmc <- suppressWarnings(tetrachoric(study2data[,c(findcolnumber(study2data, "q_14003_CRA_MC1scored"):
    findcolnumber(study2data, "q_14197_CRA_MC65scored"))], smooth = TRUE))

tetrachor_CRAmc <- tetrachor_CRAmc$rho
omega_CRAmc <- suppressWarnings(psych::omega(tetrachor_CRAmc, plot = FALSE))
round(omega_CRAmc$alpha,2)
round(omega_CRAmc$omega.tot,2)

# CRAT multiple-choice
tetrachor_CRATmc <- suppressWarnings(tetrachoric(study2data[,c(findcolnumber(study2data, "q_14289_CRAT_MC1scored"):
    findcolnumber(study2data, "q_14318_CRAT_MC30scored"))], smooth = TRUE))

tetrachor_CRATmc <- tetrachor_CRATmc$rho
omega_CRATmc <- suppressWarnings(psych::omega(tetrachor_CRATmc, plot = FALSE))
round(omega_CRATmc$alpha,2)
round(omega_CRATmc$omega.tot,2)

# In addition to sum scoring, we also use IRT scoring for the MC version of the CRA and CRAT items
# The calibrations for the IRT scores are based on the results of Study 1.

# To IRT score the new CRA item set, two of the items need to be dropped based on psychometric 
# evaluation in Study 1 (items 14043 and 14023). For the CRAT items, an additional 7 items also 
# should be left out.
MCitemsForIRT <- study2data[,-c(findcolnumber(study2data, "q_14023_CRA_MC11scored"),
                                  findcolnumber(study2data, "q_14043_CRA_MC15scored"),
                                  findcolnumber(study2data, "q_14307_CRAT_MC19scored"),
                                  findcolnumber(study2data, "q_14308_CRAT_MC20scored"),
                                  findcolnumber(study2data, "q_14310_CRAT_MC22scored"),
                                  findcolnumber(study2data, "q_14315_CRAT_MC27scored"),
                                  findcolnumber(study2data, "q_14317_CRAT_MC29scored"),
                                  findcolnumber(study2data, "q_14318_CRAT_MC30scored"),
                                  findcolnumber(study2data, "q_14298_CRAT_MC30scored")
                                  )]

# Isolate the new CRA items to IRT score
CRAitemSetFinal <- MCitemsForIRT[,c(findcolnumber(MCitemsForIRT, "q_14003_CRA_MC1scored"):
                              findcolnumber(MCitemsForIRT, "q_14197_CRA_MC65scored"))]
# Align the item labels
names(CRAitemSetFinal) <- substring(names(CRAitemSetFinal), 1, 7)

# Now load the IRT model and IRT score
load(file = paste(wdpath, "data/study1/IRTmodelCRAnewItems.rdata", sep = ""))
#load(file = "OnlineSupplement/data/study1/IRTmodelCRAnewItems.rdata")

CRAitemSetFinal = score_ICAR_IRT(dataset = CRAitemSetFinal, IRT_model = IRT_model_ICAR_CRAnew, t_score = FALSE)
marginal_rxx(IRT_model_ICAR_CRAnew)

# Isolate the CRAT items to IRT score
CRATitemSetFinal <- MCitemsForIRT[,c(findcolnumber(MCitemsForIRT, "q_14289_CRAT_MC1scored"):
                              findcolnumber(MCitemsForIRT, "q_14316_CRAT_MC28scored"))]
# Align the item labels
names(CRATitemSetFinal) <- substring(names(CRATitemSetFinal), 1, 7)

# Now load the IRT model and IRT score
load(file = paste(wdpath, "data/study1/IRTmodelCRATitems.rdata", sep = ""))
#load(file = "OnlineSupplement/data/study1/IRTmodelCRATitems.rdata")

CRATitemSetFinal = score_ICAR_IRT(dataset = CRATitemSetFinal, IRT_model = IRT_model_CRAT, t_score = FALSE)
marginal_rxx(IRT_model_CRAT)

# Tack the IRT scores onto the full data frame for Study 2
study2data <- data.frame(study2data, CRAitemSetFinal$ICAR_CRA, CRAitemSetFinal$SE_ICAR_CRA,
                         CRATitemSetFinal$CRAT, CRATitemSetFinal$SE_CRAT)

names(study2data)[names(study2data) == 'CRAitemSetFinal.ICAR_CRA'] <- 'IRTscore_CRA_MC'
names(study2data)[names(study2data) == 'CRAitemSetFinal.SE_ICAR_CRA'] <- 'IRTscore_CRA_MC_SE'
names(study2data)[names(study2data) == 'CRATitemSetFinal.CRAT'] <- 'IRTscore_CRAT_MC'
names(study2data)[names(study2data) == 'CRATitemSetFinal.SE_CRAT'] <- 'IRTscore_CRAT_MC_SE'

# Save objects out for later use
study2dataCRAonly <- subset(CRAitemSetFinal, select = c(q_14003:q_14197))
CRAitemNumbersStudy2 <- colnames(study2dataCRAonly)
save(study2dataCRAonly, CRAitemNumbersStudy2, file = paste(wdpath, "data/study2/CRAdataStudy2.rdata", sep = ""))

# Compare the two methods for scoring the multiple choice responses
compareScoringMethodCor <- round(cor(study2data[,c("meanScore_CRA_MC", "meanScore_CRAT_MC", 
                                "IRTscore_CRA_MC", "IRTscore_CRAT_MC")], use="pairwise"), 2)
compareScoringMethodCor
@
\end{scriptsize}

Results suggest that the two methods for scoring the multiple choice items are similar but not identical. The associations among the mean and IRT scores for the new CRA items is \Sexpr{compareScoringMethodCor["meanScore_CRA_MC", "IRTscore_CRA_MC"]}, and \Sexpr{compareScoringMethodCor["meanScore_CRAT_MC", "IRTscore_CRAT_MC"]} for the CRAT items. Though high, the correlations would likely be higher still if the items were more fully overlapping (recall that some items were omitted from both sets, mainly due to the removal of items with relatively poor psychometric properties when calculating the IRT scores). The correlations between the new CRA items and the CRAT items are similar regardless of scoring method (\Sexpr{compareScoringMethodCor["meanScore_CRA_MC", "meanScore_CRAT_MC"]} for mean scores and \Sexpr{compareScoringMethodCor["IRTscore_CRA_MC", "IRTscore_CRAT_MC"]} for IRT scores). Given the availability of the IRT calibrations, we recommend this method and will use these scores for all subsequent analyses in Studies 2 and 3.

\subsection{Descriptive statistics}

Now that the data have been wrangled into shape, the next code chunk describes the sample (N $=$ \Sexpr{as.numeric(describe(study2data$Age)["n"])}) and key variables before moving on to the validation analyses.

\begin{scriptsize}
<<Study2.2, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
# Scrub the data to remove implausible/impossible values for self reports of test scores and GPA
study2data <- psych::scrub(study2data, where = "ACT_Composite_Score", min = 1, max = 36)
study2data <- psych::scrub(study2data, where = "SAT_RW_Score", min = 400, max = 800)
study2data <- psych::scrub(study2data, where = "SAT_M_Score", min = 400, max = 800)
study2data <- psych::scrub(study2data, where = "GPA", min = 0, max = 5)
study2data$Ethnicity <- str_replace(study2data$Ethnicity, "Some other ethnicity or origin, please specify:", "Other")
study2data$Ethnicity <- str_replace(study2data$Ethnicity, "I prefer not to answer.", "Prefer not to say")

descriptives <- describe(study2data)

ESL <- data.frame(table(study2data$English_First_Language)[2:3])
colnames(ESL) <- c("English 1st Language?", "Participants")
ESL$Percentage <- round(ESL$Participants/sum(ESL$Participants)*100,2)

english <- data.frame(table(study2data$English_Fluency)[c(2,1)])
colnames(english) <- c("English fluency", "Participants")
english$Percentage <- round(english$Participants/sum(english$Participants)*100,2)

edu <- data.frame(table(study2data$Education)[c(4,3,5,1,2)])
colnames(edu) <- c("Educational Attainment Level", "Participants")
edu$Percentage <- round(edu$Participants/sum(edu$Participants)*100,2)

income <- data.frame(table(study2data$Income)[c(12,5,9,10,11,2,3,4,6,7,8,13,14)])
colnames(income) <- c("Household Income", "Participants")
income$Percentage <- round(income$Participants/sum(income$Participants)*100,2)

gender <- data.frame(table(study2data$Gender_Identity))
colnames(gender) <- c("Gender Identity", "Participants")
gender$Percentage <- round(gender$Participants/sum(gender$Participants)*100,2)

ethnicity <- data.frame(table(study2data$Ethnicity)[c(1:6,9,7,8)])
colnames(ethnicity) <- c("Race/Ethnicity", "Participants")
ethnicity$Percentage <- round(ethnicity$Participants/sum(ethnicity$Participants)*100,2)

descriptives[c("Age", "Duration_Minutes", "SAT_RW_Score", "SAT_M_Score", "ACT_Composite_Score", "GPA",
               "meanScore_CRAopen", "meanScore_CRATopen", "IRTscore_CRA_MC", "IRTscore_CRA_MC_SE",
               "IRTscore_CRAT_MC", "IRTscore_CRAT_MC_SE"),c("n","mean","sd", "median", "min", "max")]
@
\end{scriptsize}

Descriptive statistics for (most of) the continuous variables (i.e., age, test scores, CRA scores) are described as output in the chunk above. Note that these include the standard errors for the IRT scores of the new CRA scale (\textit{m} $=$ \Sexpr{round(descriptives["IRTscore_CRA_MC_SE","mean"],2)}) and the CRAT scale (\textit{m} $=$ \Sexpr{round(descriptives["IRTscore_CRAT_MC_SE","mean"],2)}). Categorical variables are described in Tables \ref{tab:ESL} to \ref{tab:ethnicity}. 

