addtorow$command <- command

CRAparameters167Table <- xtable(CRAparameters167, digits=0, caption='Item parameters for complete CRA item pool', label='tab:parameters167')
align(CRAparameters167Table) <- "lrrrrr"
digits(CRAparameters167Table) <- c(0,2,2,2,3,0)
print(CRAparameters167Table, tabular.environment = "longtable", include.colnames = FALSE, caption.placement = "top", add.to.row = addtorow, size='scriptsize', floating = FALSE)

# delete these lines when the table is working properly...
#print(CRATparameterstrimmedTable, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)

#print(xtable(CRAparameters167, caption = "Item parameters for complete CRA item pool", label='tab:parameters167', align = c("lccccc")), digits = c(0,2,2,2,3,0), size='scriptsize', caption.placement = "top", tabular.environment = "longtable", include.colnames = FALSE, floating = FALSE, add.to.row = addtorow)
@
\end{scriptsize}

\begin{scriptsize}
<<Study4.8, eval=TRUE, echo=FALSE, results='asis', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
CRAitemNumbersFullBank <- colnames(CRAitemSet167)
IRT_model_ICAR_CRA <- IRT_model167
save(IRT_model_ICAR_CRA, CRAitemNumbersFullBank, score_ICAR_IRT, file = paste(wdpath, "data/study4/IRTmodelCRAitemsFullBank.rdata", sep = ""))
