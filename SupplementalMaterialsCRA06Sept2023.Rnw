\begin{scriptsize}
<<Prep2functions, eval=TRUE, echo=FALSE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
findcolnumber <-
function(df, thecolumnname){
      which(colnames(df) == thecolumnname)
}

##########

findrownumber <-
function(df, therowname){
      which(rownames(df) == therowname)
}

##########

gcQuiet <- function(quiet = TRUE, ...) {
    if(quiet) invisible(gc()) else gc(...)
}

##########

score_ICAR_IRT <- function(dataset, IRT_model, SE = TRUE, t_score = TRUE)
{
  factor = deparse(substitute(IRT_model))
  factor = gsub("IRT_model_", "", factor)
  items <- names(IRT_model@Data$mins)
  data <- dataset
  #check items in dataset
  check_names = items %in% names(dataset)
  # if missing all items, throw error 
  if(sum(check_names) == 0) stop("No items for this factor found in the dataset.")
  # if missing only some items, add those items as empty columns  
  if(sum(check_names) < length(check_names)){
    missing = items[!check_names]
    data[,missing] = NA
  }
  data <- data[, items]
  # find rows that are completely empty. these cause problems with mirt
  empty_rows = which(is.nan(rowMeans(data, na.rm = TRUE)))
  if(length(empty_rows) > 0) data = data[-empty_rows, ]
  # Calculate IRT factor scores:
  fscores <- fscores(
    object = IRT_model,
    response.pattern = data
    )
  fscores <- as.data.frame(fscores)
  scores = fscores[,1]
  if(t_score) scores = scores*10 + 50
  if(t_score) fscores[,2] = fscores[,2]*10
  if(length(empty_rows) > 0){
    # if empty rows
    dataset[-empty_rows, factor] = scores
    dataset[-empty_rows, paste0("SE_", factor)] = fscores[,2]
  }else
  {
    # If there are NOT empty rows:
    dataset[, factor] = scores
    dataset[, paste0("SE_", factor)] = fscores[,2]
  }
  return(dataset)
}

# Insert other custom functions here as needed.
@
\end{scriptsize}

\section{Study 1}

The following code loads the raw data from the \textbf{[blinded for review]} for this study. Most of the data for this study are available for download and re-use (see the compressed folder labeled 'Study1data' on OSF (\href{tinyurl.com/2a8vx6n8}{tinyurl.com/2a8vx6n8}) --- these include all data related to CRA/associative ability items. However, as the validation data are part of a much larger data collection project, some of these data have been withheld temporarily with the expectation that they will be made available subsequently (consistent with prior data sharing related policies for this project). The code below shows how the complete data were loaded, described, and reduced down to a more manageable size for saving and subsequent analyses/sharing. See \textbf{[blinded for review]} for a general overview of the data collection methods. Note that the data used in Study 1 was collected between 07 February 2017 and 25 June 2022.

%blinded values are SAPA-Project with url and \citet{Condon:2017cs}

\begin{scriptsize}
<<Study1.1, eval=FALSE, echo=TRUE, results='markup', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
# First load the dataset used for the analyses.
load(paste(wdpath, "data/study1/data07feb2017thru12dec2022.rdata", sep = ""))
fullSample <- data07feb2017thru12dec2022
rm(data07feb2017thru12dec2022)
gcQuiet()

dim(fullSample)
count_answered <- describe(fullSample$count_answered)

pdf(paste(wdpath, "figure/counts.pdf", sep = ""), onefile = TRUE)
hist(fullSample$count_answered, 250, xlab="Items Answered", 
     xlim = c(0,250), ylim = c(0,200000), main = "")
dev.off()

# subset the data
fluencyAll <- table(fullSample$english)
CRAdata <- fullSample %>% dplyr::filter(english == "Well" | english == "VeryWellFluentNative")
dim(CRAdata)
rm(fullSample)
gcQuiet()

# based on age
CRAdata <- subset(CRAdata, CRAdata$age > 13)
dim(CRAdata)

# create table objects for printing further down
countryCount <- table(CRAdata$country)
ncountry = sum(countryCount != 0)
USperc = as.numeric(countryCount["USA"])/nrow(CRAdata)

ethnic <- data.frame(table(CRAdata$ethnic))
ethnic$Percentage <- round(ethnic$Freq/sum(ethnic$Freq), 3)*100
colnames(ethnic) <- c("Ethnicity/Race", "Participants", "Percentage")

education <- data.frame(table(CRAdata$education))
education$Percentage <- round(education$Freq/sum(education$Freq), 3)*100
colnames(education) <- c("Educational Level", "Participants", "Percentage")

jobstatus <- data.frame(table(CRAdata$jobstatus))
jobstatus$Percentage <- round(jobstatus$Freq/sum(jobstatus$Freq), 3)*100
colnames(jobstatus) <- c("Job Status", "Participants", "Percentage")

IRTscores <- c("SPI_135_27_5_Impulsivity_score", "SPI_135_27_5_Adaptability_score",
                "SPI_135_27_5_SelfControl_score", "SPI_135_27_5_Compassion_score", 
                "SPI_135_27_5_Creativity_score", "SPI_135_27_5_Charisma_score", 
                "SPI_135_27_5_Perfectionism_score", "SPI_135_27_5_Conformity_score", 
                "SPI_135_27_5_Order_score", "SPI_135_27_5_EmotionalStability_score", 
                "SPI_135_27_5_Irritability_score", "SPI_135_27_5_EmotionalExpressiveness_score", 
                "SPI_135_27_5_Intellect_score", "SPI_135_27_5_Humor_score", 
                "SPI_135_27_5_Sociability_score", "SPI_135_27_5_Conservatism_score", 
                "SPI_135_27_5_ArtAppreciation_score", "SPI_135_27_5_Authoritarianism_score", 
                "SPI_135_27_5_Trust_score", "SPI_135_27_5_Honesty_score", 
                "SPI_135_27_5_AttentionSeeking_score", "SPI_135_27_5_WellBeing_score", 
                "SPI_135_27_5_SensationSeeking_score", "SPI_135_27_5_Introspection_score", 
                "SPI_135_27_5_Anxiety_score", "SPI_135_27_5_Industry_score", 
                "SPI_135_27_5_EasyGoingness_score", "ICAR_LN_IRT_score", 
                "ICAR_MR_IRT_score", "ICAR_R3D_IRT_score", 
                "ICAR_VR_IRT_score", "ICAR_FA_IRT_score", 
                "ICAR_PR_IRT_score")
demoShort <- c("RID", "servertime", "age", "sex", "major", "occupation")
Study1items <- c(demoShort, itemsICAR, itemsSPI, IRTscores)

CRAdata <- subset(CRAdata, select = c(Study1items))
dim(CRAdata)

# load the item information with the text and labels
load(paste(wdpath, "data/CRAitemContent.rdata", sep = ""))
# and a file used to describe the sample by country
load(paste(wdpath, "data/study1/countrykey.rdata", sep = ""))

CRAitemData <- subset(CRAdata, select = c(servertime, q_14003:q_14466))
save(CRAitemData, CRAitemContent, file = paste(wdpath, "data/study1/CRAdataStudy1version1.rdata", sep = ""))

save(count_answered, countryCount, countrykey, CRAdata, CRAitemContent, ethnic, education, jobstatus, 
     fluencyAll, itemsSPI, jobstatus, keys.list, ncountry, USperc, 
     file = paste(wdpath, "data/study1/CRAdataStudy1version2.rdata", sep = ""))
@
\end{scriptsize}

\subsection{Descriptive statistics for participants in the sample}

The code below generates descriptive statistics for the sample. Some of the code in this sub-section (for reproducing the descriptive statistics) and in sub-section 1.7 (for identifying the correlations with other traits) requires access to the complete data file (version 2) ; the remaining code is reproducible with version 1 only.

\begin{scriptsize}
<<Study1.2, eval=TRUE, echo=TRUE, results='markup', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
load(paste(wdpath, "data/study1/CRAdataStudy1version2.rdata", sep = ""))

CRAdata <- CRAdata[CRAdata$servertime < as.POSIXct("2022-06-26 12:00:00", tz="UTC"),]
dim(CRAdata)

occupation = table(CRAdata$occupation)
occupations <- data.frame(sort(occupation, decreasing = TRUE))
colnames(occupations) <- c("Jobs", "Participants")
nocc = sum(occupation != 0)
pocc = sum(table(CRAdata$occupation))

ages <- describe(CRAdata$age)

sex.t = CRAdata %>% 
  group_by(sex) %>%
  dplyr::summarize(count = n()) %>%
  mutate(percent = 100*count/sum(count))

@
\end{scriptsize}

The total sample included \Sexpr{prettyNum(count_answered$n, big.mark=",", scientific=F)} participants who completed all or part of the full inventory in exchange for information about their personalities. Figure \ref{fig:counts} provides a distribution of the number of responses provided by each participant (\textit{m} = \Sexpr{round(count_answered$mean, 1)}; \textit{sd} = \Sexpr{round(count_answered$sd, 1)}; \textit{Mdn} = \Sexpr{count_answered$median}).

From the full sample, participants were excluded if they self-reported that they did not speak English well (n = \Sexpr{prettyNum(as.numeric(fluencyAll["NotWell"]), big.mark=",", scientific=F)}) or at all (i.e., needed translation; n = \Sexpr{prettyNum(as.numeric(fluencyAll["NotAtAllNeedTranslation"]), big.mark=",", scientific=F)}), or if they did not indicate their English language fluency (n = \Sexpr{prettyNum(as.numeric(count_answered$n-sum(fluencyAll)), big.mark=",", scientific=F)}). This left a sample of \textbf{\Sexpr{prettyNum(nrow(CRAdata), big.mark=",", scientific=F)} participants} who spoke English well (n = \Sexpr{prettyNum(as.numeric(fluencyAll["Well"]), big.mark=",", scientific=F)}) or very well/fluent (n = \Sexpr{prettyNum(as.numeric(fluencyAll["VeryWellFluentNative"]), big.mark=",", scientific=F)}). This sample had an average age of \Sexpr{round(ages$mean, 1)} (\textit{sd} = \Sexpr{round(ages$sd, 1)}; \textit{Mdn} = \Sexpr{ages$median}; minimum = \Sexpr{ages$min}; maximum = \Sexpr{ages$max}). Approximately \Sexpr{round(sex.t$percent[2])}\% self-identified as female, \Sexpr{round(sex.t$percent[1])}\% as male, and \Sexpr{round(sex.t$percent[3],2)}\% as other (\Sexpr{round(sex.t$percent[4],2)}\% did not respond to the item about gender). 

\begin{figure}
\begin{floatrow}
\ffigbox{\includegraphics[width=.5\textwidth]{figure/counts.pdf}}{\caption{Distribution of responses per participant}\label{fig:counts}}
\end{floatrow}
\end{figure}

With respect to geographic distribution, \Sexpr{ncountry} nation states were represented and approximately \Sexpr{round(USperc*100, 2)}\% of respondents were from the U.S. This included representation from all regions of the U.S. at a level similar to the distribution of residents, as indicated by moderate to high correlations between the distribution of the sample and the distribution of U.S. population (.47 using smaller 5 digit ZIP code areas and .81 using larger 3 digit ZIP code areas). Figures \ref{fig:USmap} and \ref{fig:SAPAmap} show the geographic distribution of the sample within the U.S. and by country, respectively. Table \ref{tab:countryCount1500} shows the number of respondents per country for those with more than 1,500 respondents.

\begin{figure}
\begin{floatrow}
\ffigbox{\includegraphics[width=.45\textwidth]{figure/USmap.png}}{\caption{Full sample by U.S. Zip Code Tabulation Area}\label{fig:USmap}}
\ffigbox{\includegraphics[width=.45\textwidth]{figure/sapamap.png}}{\caption{Full sample by country}\label{fig:SAPAmap}}
\end{floatrow}
\end{figure}

\begin{scriptsize}
<<Study1.3, eval=TRUE, echo=FALSE, results='asis', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
countries <- data.frame(sort(countryCount, decreasing = TRUE))
colnames(countries) <- c("ISO3", "Participants")
topCountries <- subset(countries, countries$Participants > 1500)

countrykey1500 <- subset(countrykey, ISO3 %in% topCountries$ISO3)

topCountriesKeyed <- merge(topCountries, countrykey1500, by="ISO3", all.x=TRUE)
topCountriesKeyed <- subset(topCountriesKeyed, select = c(allcountrynames, Participants, popRank, EnglishPopRank))
colnames(topCountriesKeyed) <- c("Country", "Participants", "Population Rank", "English Speaking Rank")
topCountriesKeyed <- topCountriesKeyed[with(topCountriesKeyed, order(-Participants)),]
rownames(topCountriesKeyed) <- topCountriesKeyed[,1]

comment <- list(pos = list(0), command = NULL)
comment$pos[[1]] <- c(nrow(topCountriesKeyed))
comment$command <- c(paste("\\hline\n",
                          "\\multicolumn{4}{l}{Note: Ranks based on 2022 estimates from Wikipedia.}\\\\\n", sep = ""))

options(xtable.NA.string = "NA")
topCountry <- xtable(topCountriesKeyed[,c(2:4)], digits=0, caption='Countries with 1500 or more respondents', label='tab:countryCount1500', align= c("p{3.5cm}", "R{1.5cm}", "R{1.5cm}", "R{1.5cm}"))

print(topCountry, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)
@
\end{scriptsize}

Tables \ref{tab:ethnic} and \ref{tab:education} show the distribution of the sample by ethnicity/race and educational attainment level, respectively. Table \ref{tab:job} shows the distribution of the sample by employment status. Participants who reported being employed or retired were prompted to indicate their occupation; \Sexpr{prettyNum(pocc, big.mark=",")} participants responded to this prompt, representing a total of \Sexpr{prettyNum(nocc, big.mark=",")} jobs.

