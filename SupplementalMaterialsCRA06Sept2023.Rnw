White & \Sexpr{prettyNum(ethnicity[7,2], big.mark=",", scientific=F)} & \Sexpr{prettyNum(ethnicity[7,3], big.mark=",", scientific=F)}\% \cr
Other & \Sexpr{prettyNum(ethnicity[8,2], big.mark=",", scientific=F)} & \Sexpr{prettyNum(ethnicity[8,3], big.mark=",", scientific=F)}\% \cr
Prefer not to say & \Sexpr{prettyNum(ethnicity[9,2], big.mark=",", scientific=F)} & \Sexpr{prettyNum(ethnicity[9,3], big.mark=",", scientific=F)}\% \cr
 \hline
\end{tabular}
\end{center}
\label{tab:ethnicity}
\end{table} 
\end{scriptsize}


\subsection{Correlations among CRA scores, GPA, and standardized test scores}

The preregistration specified that correlations would be reported (in the main manuscript) if there were at least 200 pairwise observations. The number of observations was not above this threshold for the SAT verbal (\Sexpr{descriptives["SAT_RW_Score",]$n}) or SAT math (\Sexpr{descriptives["SAT_M_Score",]$n}) scores, but the ACT composite scores (N = \Sexpr{descriptives["ACT_Composite_Score",]$n}) and GPAs were more than adequate (N = \Sexpr{descriptives["GPA",]$n}). These analyses are run in the following code chunk and shown at the end.

\begin{scriptsize}
<<Study2.3, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
# Subset the relevant scores from the main data set
scoresSubset <- subset(study2data, select = c(SAT_RW_Score, SAT_M_Score, ACT_Composite_Score,
                                              GPA, meanScore_CRAopen, meanScore_CRATopen,
                                              IRTscore_CRA_MC, IRTscore_CRAT_MC))
scoresCor <- cor.ci(scoresSubset, plot = FALSE)

# But only some of these should be reported given the preregistration
scoresSubset2 <- subset(study2data, select = c(ACT_Composite_Score, GPA, 
                                               meanScore_CRAopen, meanScore_CRATopen,
                                              IRTscore_CRA_MC, IRTscore_CRAT_MC))
scoresCor2 <- cor.ci(scoresSubset2, plot = FALSE)

# Get the correlations
cors <- round(scoresCor2$rho, 2)
# and the 95% confidence intervals
CIs <- round(scoresCor2$ci[,c("lower", "upper", "p")], 3)
cors
CIs

# Comparing correlations 

# Are correlations for ACT with open ended vs mc response format significantly different?
corr.test(scoresSubset$ACT_Composite_Score, scoresSubset$meanScore_CRAopen, use = "pairwise")
corr.test(scoresSubset$ACT_Composite_Score, scoresSubset$IRTscore_CRA_MC, use = "pairwise")
paired.r(0.33, 0.19, n=213, n2=210, twotailed=TRUE)

# Are correlations for GPA with open ended vs mc response format significantly different?
corr.test(scoresSubset$GPA, scoresSubset$meanScore_CRAopen, use = "pairwise")
corr.test(scoresSubset$GPA, scoresSubset$IRTscore_CRA_MC, use = "pairwise")
paired.r(0.14, 0.17, n=452, n2=446, twotailed=TRUE)

# Are correlations for item sets of the same response format significantly different?
corr.test(scoresSubset$meanScore_CRAopen, scoresSubset$meanScore_CRATopen, use = "pairwise")
corr.test(scoresSubset$IRTscore_CRA_MC, scoresSubset$IRTscore_CRAT_MC, use = "pairwise")
paired.r(0.44, 0.48, n=675, n2=673, twotailed=TRUE)

# Are correlations for the same items sets, using different response formats, significantly different?
corr.test(scoresSubset$meanScore_CRAopen, scoresSubset$IRTscore_CRA_MC, use = "pairwise")
corr.test(scoresSubset$meanScore_CRATopen, scoresSubset$IRTscore_CRAT_MC, use = "pairwise")
paired.r(0.36, 0.43, n=675, n2=673, twotailed=TRUE)
@
\end{scriptsize}

ACT composite score was significantly correlated with both CRA and CRAT item scores across response modes (i.e., multiple-choice and open-ended), but correlations were stronger when using the open-ended response mode. GPA showed significant correlations with CRA item scores when using both multiple-choice and open-ended response mode. The correlation between GPA and CRAT item scores was significant when using a multiple-choice response mode but not when using an open-ended response mode. The difference in the magnitudes of the correlations across response choices for the ACT only (i.e., not GPA) may have reflected the greater difficulty of the open-ended response method (see below), as there is considerable evidence that the ACT and other standardized tests are more direct measures of cognitive ability than GPA \citep{Galla:2019}. GPA, by contrast, is also affected by other aspects of personality (e.g., self-regulation skills).

All correlations between the same measure when using different response modes (e.g., multiple-choice CRA items and open-ended CRA items), and different measures using the same response mode (e.g., open-ended CRA items and open-ended CRAT items) were significant. The strongest relationship across combinations of measure (CRA and CRAT) and response mode (multiple-choice and open-ended) emerged between the CRA and CRAT items using the multiple-choice format. This could be due to both the relative ease of solving the multiple-choice items and the greater precision afforded by IRT scoring, which was not possible for the open-ended items.

Note that exploratory analyses of the correlations with SAT verbal scores were statistically significant for the new CRA items with the open-ended response format (\textit{r}$=$.25, \textit{p}$=$.01) and for the IRT-scored multiple-choice format (\textit{r}$=$.29, \textit{p}$=$.006), despite the small sample size. None of the other SAT correlations were statistically significant (\textit{p}$<$.05).

\subsection{Effects of response format and problem set}

In order to evaluate the effect of response format (open-ended vs multiple choice) and of problem set (CRAT vs new CRA items), it is first necessary to pivot the data into long format (i.e., one row for each item for each participant). This is done below, along with dummy coding according to response and problem type.

\begin{scriptsize}
<<Study2.4, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
# Getting the data into long form
Study2_Data_Long <- study2data %>%
                    pivot_longer(cols = c(q_14003_CRA_open1scored:q_14318_CRAT_MC30scored),
                    names_to = "Item",
                    values_to = "Score")
# Creating dummy variables for problem set and response mode
Study2_Data_Long <- Study2_Data_Long %>%
                    mutate(Set = ifelse(str_detect(Item, "CRAT"), 0, 1),
                    Format = ifelse(str_detect(Item, "open"), 0, 1))
# Problem set and response mode variables as factors
Study2_Data_Long$Set <- factor(Study2_Data_Long$Set,
                             levels = c(0,1),
                             labels = c("CRAT","CRA"))
Study2_Data_Long$Format <- factor(Study2_Data_Long$Format,
                             levels = c(0,1),
                             labels = c("Open-ended","Multiple-choice"))
@
\end{scriptsize}

Then, we begin by modelling just the main effects of (1) problem set (CRAT vs CRA) and (2) response format (open-ended vs multiple-choice). This is done in the code chunk below, using a binary logitistic multilevel model with item scores predicted by `set' and `format'. 

\begin{scriptsize}
<<Study2.5, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
Format_Model_main <- glmer(Score ~ Format + Set + (1 | ResponseId), data = Study2_Data_Long, family = "binomial")
summary(Format_Model_main)
@
\end{scriptsize}

\begin{scriptsize}
<<Study2.6, eval=TRUE, echo=FALSE, results='asis', tidy=FALSE, message=FALSE, warning=FALSE>>=
# tables of estimates with 95% CI
se_main <- sqrt(diag(vcov(Format_Model_main)))
tab_main <- cbind(Est = lme4::fixef(Format_Model_main), 
                  lowerCI = lme4::fixef(Format_Model_main) - 1.96 * se_main, 
                  upperCI = lme4::fixef(Format_Model_main) + 1.96 * se_main)
tab_main <- as.data.frame(tab_main)
tab_main$OR <- exp(tab_main$Est)

colnames(tab_main) <- c("Estimate", "CI lower", "CI upper", "Odds Ratio")
rownames(tab_main) <- c("Intercept", "Response Format (Open vs MC)", "Problem Set (CRAT v CRA)")
comment <- list(pos = list(0), command = NULL)
comment$pos[[1]] <- c(nrow(tab_main))
comment$command <- c(paste("\\hline\n",
                          "\\multicolumn{5}{l}{Notes: The estimate values are the logistic regression coefficients. CI lower}\\\\\n",
                          "\\multicolumn{5}{l}{and upper represent the bounds of the 95 confidence interval.}\\\\\n",
                          "\\multicolumn{5}{l}{Reference group is open-ended CRAT items.}\\\\\n", sep = ""))

tab_main <- xtable(tab_main, digits=0, caption='Model summary testing the main effects', label='tab:modelmain')
align(tab_main) <- "lcccc"
digits(tab_main) <- c(0,2,2,2,2)
print(tab_main, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)

Format_plot_main <- ggpredict(Format_Model_main, c("Format", "Set")) %>% 
  ggplot(aes(x = x, y = predicted, group = group)) +
  geom_bar(stat = "identity", aes(fill = group), position = position_dodge(.9)) +
  geom_errorbar(aes(ymin = conf.high, ymax = conf.low),
                width = .5, 
                position = position_dodge(.9)) +
    labs(
        x = "Response Format",
        y = "Probability of a Correct Response",
        title = "",
        fill = "Problem Set") + 
  theme_bw() +
    theme(axis.text.x = element_text(color="black", size=8),
          axis.title.x = element_text(colour = "black", size = 10),
          axis.text.y = element_text(color="black", size=8),
          axis.title.y = element_text(colour = "black", size = 10), 
          legend.position = "top")
    ggsave(filename = paste(wdpath, "figure/modelmain.png", sep=""), scale = 1, width = 7, height = 5, units = c("in"), dpi = 300)
@
\end{scriptsize}


A summary of the results are shown in the code and output above, as well as in Table \ref{tab:modelmain}. The odds ratio values indicate that the change in odds of correctly responding to the items increases by \Sexpr{round(tab_main[2,4], 2)} from CRAT items with an open-ended response format to CRAT items with a multiple-choice format. The odds decrease when going from CRAT items to the new CRA items (odds are \Sexpr{round(tab_main[3,4], 2)}). These results are also reflected in Figure \ref{fig:modelmain}.

\begin{figure}
\begin{floatrow}
\ffigbox{\includegraphics[width=.65\textwidth]{figure/modelmain.png}}{\caption{Effects of response format and item type on CRA scores}\label{fig:modelmain}}
\end{floatrow}
\end{figure}

To follow up on the main effects analysis, we then identify a model that also includes the interaction effect between problem format and problem set. The next code chunk shows the results.

\begin{scriptsize}
<<Study2.7, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
Format_Model_interaction <- glmer(Score ~ Format*Set + (1 | ResponseId), data = Study2_Data_Long, family = "binomial")
summary(Format_Model_interaction)

@
\end{scriptsize}

\begin{scriptsize}
<<Study2.8, eval=TRUE, echo=FALSE, results='asis', tidy=FALSE, message=FALSE, warning=FALSE>>=
# tables of estimates with 95% CI
se_interaction <- sqrt(diag(vcov(Format_Model_interaction)))
tab_interaction <- cbind(Est = lme4::fixef(Format_Model_interaction), 
                         lowerCI = lme4::fixef(Format_Model_interaction) - 1.96 * se_interaction, 
                         upperCI = lme4::fixef(Format_Model_interaction) + 1.96 * se_interaction)
tab_interaction <- as.data.frame(tab_interaction)
tab_interaction$OR <- exp(tab_interaction$Est)

colnames(tab_interaction) <- c("Estimate", "CI lower", "CI upper", "Odds Ratio")
rownames(tab_interaction) <- c("(Intercept)", "Response Format (Open vs MC)", "Problem Set (CRAT v CRA)", "Interaction")
comment <- list(pos = list(0), command = NULL)
comment$pos[[1]] <- c(nrow(tab_interaction))
comment$command <- c(paste("\\hline\n",
                          "\\multicolumn{5}{l}{Notes: The estimate values are the logistic regression coefficients. CI lower}\\\\\n",
                          "\\multicolumn{5}{l}{and upper represent the bounds of the 95 confidence interval.}\\\\\n", sep = ""))

tab_interaction <- xtable(tab_interaction, digits=0, caption='Model summary testing the main effects and interaction', label='tab:modelinter')
align(tab_interaction) <- "lcccc"
digits(tab_interaction) <- c(0,2,2,2,2)
print(tab_interaction, add.to.row = comment, hline.after = c(-1,0,NULL), size='scriptsize', floating = TRUE)

Format_plot_inter <- ggpredict(Format_Model_interaction, c("Format", "Set")) %>% 
  ggplot(aes(x = x, y = predicted, group = group)) +
  geom_bar(stat = "identity", aes(fill = group), position = position_dodge(.9)) +
  geom_errorbar(aes(ymin = conf.high, ymax = conf.low),
                width = .5, 
                position = position_dodge(.9)) +
    labs(
        x = "Response Format",
        y = "Probability of a Correct Response",
        title = "",
        fill = "Problem Set") + 
  theme_bw() +
    theme(axis.text.x = element_text(color="black", size=8),
          axis.title.x = element_text(colour = "black", size = 10),
          axis.text.y = element_text(color="black", size=8),
          axis.title.y = element_text(colour = "black", size = 10), 
          legend.position = "top")
    ggsave(filename = paste(wdpath, "figure/modelinter.png", sep=""), scale = 1, width = 7, height = 5, units = c("in"), dpi = 300)
@
\end{scriptsize}

In this case, the results are similar (directionally) and there is a statistically significant effect of the interaction. (In practical terms, this also suggests that the main effects analysis is probably not an accurate representation of the true relationships tested.) Table \ref{tab:modelinter} shows the effects with the same reference groups (open-ended response format and CRAT problems). The odds ratios are \Sexpr{round(tab_interaction[1,4], 2)} for the effect of response choice format and \Sexpr{round(tab_interaction[2,4], 2)} for the effect of item content/type. Figure \ref{fig:modelinter} shows a plot of the model including the interaction effect.

\begin{figure}
\begin{floatrow}
\ffigbox{\includegraphics[width=.65\textwidth]{figure/modelinter.png}}{\caption{Effects of response format and item type on CRA scores}\label{fig:modelinter}}
\end{floatrow}
\end{figure}

\section{Study 3}

The aim of Study 3 was to validate the new CRA item set from Study 1 in an additional (non-student) sample. In this case, the measures were cross-validated against measures of cognitive reflection \citep[using items from various versions of the Cognitive Reflection Task;][]{Frederick:2005, Primi:2016, Thomson:2016} and imagination \citep[using the Four-Factor Imagination Scales;][]{Zabelina:2020}. This sample was also used to evaluate test-retest reliability. Data were collected from a crowd-sourcing recruitment platform (\href{https://www.prolific.co/}{Prolific}) in February/March 2021 (see dates below). These data are available on OSF (\href{tinyurl.com/2a8vx6n8}{tinyurl.com/2a8vx6n8}) in a file labeled 'Study3data.csv'; as these data are considerably more involved than those in Study 2, we have also provided a codebook. In the following subsections, we describe the steps for loading and cleaning the data, and carrying out the planned analyses.

\subsection{Data wrangling}

Begin by loading, cleaning, and scoring the data. Note that the data have already been de-identified, and that responses to the individual items have already been scored as correct (1) or incorrect (0). 

\begin{scriptsize}
<<Study3.1, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
rm(list=ls()[!(ls() %in% c('findcolnumber', 'keys.list', 'wdpath', 'score_ICAR_IRT', 'CRAitemNumbersStudy1'))])

# Load the de-identified data file. The raw data file has been cleaned to 
# remove identifying data that is automatically collected by Qualtrics.

# Note that the data for Study 3 are very involved; see the codebook file on OSF 
# for more info about the nature and naming of variables (`Study3dataCodebook').
study3data <- read.csv(paste(wdpath, "data/study3/study3data.csv", sep=""), header=TRUE)
#study3data <- read.csv("OnlineSupplement/data/study3/study3data.csv", header=TRUE)
study3data <- study3data[-c(1:2),]

# change class of variables in character format (not sure why... qualtrics)
cols.num <- colnames(study3data[,c(findcolnumber(study3data, "FFIS_F1"):
                     findcolnumber(study3data, "FFIS_D5"),
                     findcolnumber(study3data, "MultipleChoice_DO_q_14066_retest"):
                     findcolnumber(study3data, "MultipleChoice_DO_q_14051_retest"))])
study3data[cols.num] <- sapply(study3data[cols.num],as.numeric)

# clean out unexpected handling of NAs for some cases in qualtrics
study3data[cols.num] <- psych::scrub(study3data[cols.num], isvalue= c(-99))

names(study3data)[3] <- 'duration' # relabel
study3data$duration <- as.numeric(study3data[,"duration"]) # as numeric from character
study3data$age <- as.numeric(study3data[,"age"]) # as numeric from character
NbeforeDrops <- dim(study3data)[1]

study3data <- subset(study3data, select = -c(RecordedDate, UserLanguage)) # drop as uninformative

# Subset the data to remove respondents who self-report lower English fluency levels
table(study3data$english)
study3data <- study3data %>% dplyr::filter(english == "Well" | english == "Very well (fluent/native)")
dim(study3data)

# Fix the date formatting
study3data[,"StartDate"] <- substr(study3data[,"StartDate"], 1, 7) # reformat the date columns
study3data[,"StartDate"] <- as.Date(study3data$StartDate, "%m/%d/%y")
study3data[,"EndDate"] <- substr(study3data[,"EndDate"], 1, 7) # reformat the date columns
study3data[,"EndDate"] <- as.Date(study3data$EndDate, "%m/%d/%y")
study3data[,"StartDate_retest"] <- as.Date(as.numeric(study3data$StartDate_retest), origin = '1900-01-01')
study3data[,"EndDate_retest"] <- as.Date(as.numeric(study3data$EndDate_retest), origin = '1900-01-01')
dim(study3data)

# Subset the data to remove data collected outside the Prolific dates
study3data <- study3data[study3data$StartDate >= "2021-02-23",]
dim(study3data)
Nactual <- dim(study3data)[1]

# When were the data collected in the first wave?
table(study3data$EndDate)
begin <- min(study3data$EndDate)
end <- max(study3data$EndDate)

# And when in the test-retest?
table(study3data$EndDate_retest)
beginRetest <- min(study3data$EndDate_retest)
endRetest <- max(study3data$EndDate_retest)

study3data$retestInterval <- as.numeric(difftime(study3data$EndDate_retest, study3data$EndDate))
retestIntervalStats <- describe(study3data$retestInterval)

@
\end{scriptsize}

The first round of data collection for Study 3 ran from \Sexpr{begin} and ended on \Sexpr{end}; the second round (re-test data) were collected a mean of \Sexpr{round(retestIntervalStats$mean,1)} days later (min $=$ \Sexpr{round(retestIntervalStats$min,1)}; max $=$ \Sexpr{round(retestIntervalStats$max,1)}). Of the \Sexpr{NbeforeDrops} participants involved in the first wave, \Sexpr{NbeforeDrops-Nactual} were removed due to low self-reported levels of English language fluency. This left \Sexpr{Nactual} participants at the first wave. From these, \Sexpr{retestIntervalStats$n} participated in the retest assessment roughly two weeks later.

\begin{scriptsize}
<<Study3.2, eval=TRUE, echo=FALSE, results='hide', tidy=FALSE, message=FALSE, warning=FALSE>>=
# In this chunk, we score the data.
# Begin by subsetting the data as needed.
study3datatrimmed <- subset(study3data, select = c(age, duration, english_native, english, education, income, gender, StartDate, EndDate, EndDate_retest, retestInterval, FFIS_F1:FFIS_D5, CRT_1_scored:CRT_10_scored, q_14003_scored:q_14197_scored, q_14003_retest_scored:q_14197_retest_scored, MultipleChoice_DO_q_14066_retest:MultipleChoice_DO_q_14051_retest))

FFISitems <- study3datatrimmed[,c(findcolnumber(study3datatrimmed, "FFIS_F1"):
                             findcolnumber(study3datatrimmed, "FFIS_D5"))]
colnames(FFISitems) <- c("q_5063", "q_5082", "q_5073", "q_5087",
                         "q_5076", "q_5069", "q_5066", "q_5088",
                         "q_5092", "q_5086", "q_5074", "q_5081",
                         "q_5068", "q_5080", "q_5090", "q_5067",
                         "q_5070", "q_5075", "q_5071", "q_5065",
                         "q_5083", "q_5062", "q_5085", "q_5089",
                         "q_5072", "q_5091")

CRTitems <- study3datatrimmed[,c(findcolnumber(study3datatrimmed, "CRT_1_scored"):
                            findcolnumber(study3datatrimmed, "CRT_10_scored"))]

CRAitemsForIRTwave1 <- study3datatrimmed[,c(findcolnumber(study3datatrimmed, "q_14003_scored"):
                                       findcolnumber(study3datatrimmed, "q_14197_scored"))]

CRAitemsForIRTwave2 <- study3datatrimmed[,c(findcolnumber(study3datatrimmed, "q_14003_retest_scored"):
                                       findcolnumber(study3datatrimmed, "q_14197_retest_scored"))]

# Now score by subset
# Get the sum/mean scores for the FFIS scales and the reliabilities
makeFFISkeys <- keys.list[c("FFISfrequency", "FFISNegEmoValence", "FFIScomplexity", "FFISdirectedness")]
FFISkey <- make.keys(FFISitems, makeFFISkeys)
FFISscored <- scoreItems(FFISkey, FFISitems, totals=FALSE, impute="none", min=1, max=6)
FFISreliabilities <- FFISscored$alpha
study3datatrimmed$FFISfrequencyScores <- FFISscored$scores[,"FFISfrequency"]
study3datatrimmed$FFISNegEmoValenceScores <- FFISscored$scores[,"FFISNegEmoValence"]
study3datatrimmed$FFIScomplexityScores <- FFISscored$scores[,"FFIScomplexity"]
study3datatrimmed$FFISdirectednessScores <- FFISscored$scores[,"FFISdirectedness"]

# Get the sum/mean scores for the CRT items and the reliabilities
key = list(CRT = c("CRT_1_scored", "CRT_2_scored", "CRT_3_scored", "CRT_4_scored",
                     "CRT_5_scored", "CRT_6_scored", "CRT_7_scored", "CRT_8_scored",
                     "CRT_9_scored", "CRT_10_scored"))
CRTkey <- make.keys(CRTitems, key)

CRTscored <- scoreItems(CRTkey, CRTitems, totals=FALSE, impute="none", min=0, max=1)
CRTreliabilities <- CRTscored$alpha
study3datatrimmed$CRTscores <- CRTscored$scores[,"CRT"]

itemCounts <- c(length(keys.list$FFISfrequency), length(keys.list$FFISNegEmoValence), length(keys.list$FFIScomplexity), length(keys.list$FFISdirectedness), length(key$CRT))

reliabilitiesdf <- round(data.frame(FFISreliabilities, CRTreliabilities),2)
reliabilitiesdf <- rbind(reliabilitiesdf, itemCounts)
colnames(reliabilitiesdf) <- c("FFIS Frequency", "FFIS Emotional Valence", "FFIS Complexity", "FFIS Directedness", "CRT")
rownames(reliabilitiesdf) <- c("alpha", "items")


# Alpha and omega for FFIS scales, CRT, and CRA waves
omega_FFIS_F <- suppressWarnings(omega(study3datatrimmed[,c(findcolnumber(study3datatrimmed, "FFIS_F1"):
      findcolnumber(study3datatrimmed, "FFIS_F9"))], plot = F))

omega_FFIS_C <- omega(study3datatrimmed[,c(findcolnumber(study3datatrimmed, "FFIS_C1"):
      findcolnumber(study3datatrimmed, "FFIS_C5"))], plot = F)

omega_FFIS_EV <- omega(study3datatrimmed[,c(findcolnumber(study3datatrimmed, "FFIS_EV1"):
      findcolnumber(study3datatrimmed, "FFIS_EV7"))], plot = F)

omega_FFIS_D <- suppressWarnings(omega(study3datatrimmed[,c(findcolnumber(study3datatrimmed, "FFIS_D1"):
      findcolnumber(study3datatrimmed, "FFIS_D5"))], plot = F))

omega_CRT <- omega(study3datatrimmed[,c(findcolnumber(study3datatrimmed, "CRT_1_scored"):
      findcolnumber(study3datatrimmed, "CRT_10_scored"))], plot = F)

omega_CRAwave1 <- omega(CRAitemsForIRTwave1, plot = F)


omega_FFIS_F$omega.tot
omega_FFIS_F$alpha

omega_FFIS_C$omega.tot
omega_FFIS_C$alpha

omega_FFIS_EV$omega.tot
omega_FFIS_EV$alpha

omega_FFIS_D$omega.tot
omega_FFIS_D$alpha

omega_CRT$omega.tot
omega_CRT$alpha

omega_CRAwave1$omega.tot
omega_CRAwave1$alpha


####
# IRT scores for CRA
####
# Align the item labels for wave 1
names(CRAitemsForIRTwave1) <- substring(names(CRAitemsForIRTwave1), 1, 7)

# Now load the IRT model and IRT score
load(file = paste(wdpath, "data/study1/IRTmodelCRAnewItems.rdata", sep = ""))
#load(file = "OnlineSupplement/data/study1/IRTmodelCRAnewItems.rdata")

marginal_rxx(IRT_model_ICAR_CRAnew) # Marginal reliability 
CRAscoreIRTwave1 = score_ICAR_IRT(dataset = CRAitemsForIRTwave1, IRT_model = IRT_model_ICAR_CRAnew, t_score = TRUE)
study3datatrimmed$CRAscoreIRTwave1_score <- CRAscoreIRTwave1$ICAR_CRA
study3datatrimmed$CRAscoreIRTwave1_se <- CRAscoreIRTwave1$SE_ICAR_CRA

# And wave 2
names(CRAitemsForIRTwave2) <- substring(names(CRAitemsForIRTwave2), 1, 7)
CRAscoreIRTwave2 = score_ICAR_IRT(dataset = CRAitemsForIRTwave2, IRT_model = IRT_model_ICAR_CRAnew, t_score = TRUE)
study3datatrimmed$CRAscoreIRTwave2_score <- CRAscoreIRTwave2$ICAR_CRA
study3datatrimmed$CRAscoreIRTwave2_se <- CRAscoreIRTwave2$SE_ICAR_CRA

descriptives <- suppressWarnings(describe(study3datatrimmed))

# Save objects out for later use
CRAitemNumbersStudy3 <- colnames(CRAitemsForIRTwave1)
study3dataCRAonly <- CRAitemsForIRTwave1
save(study3dataCRAonly, CRAitemNumbersStudy3, file = paste(wdpath, "data/study3/CRAdataStudy3.rdata", sep = ""))
@
\end{scriptsize}

\subsection{Descriptive statistics}

The next code chunk describes the sample (N $=$ \Sexpr{as.numeric(describe(study3data$age)["n"])}) and key variables before moving on to the analyses.

\begin{scriptsize}
<<Study3.3, eval=TRUE, echo=TRUE, results='markup', tidy=FALSE, message=FALSE, warning=FALSE>>=
descriptives[c("age", "FFISfrequencyScores", "FFISNegEmoValenceScores", "FFIScomplexityScores", 
               "FFISdirectednessScores", "CRTscores", "CRAscoreIRTwave1_score", 
               "CRAscoreIRTwave2_score"),c("n","mean","sd", "median", "min", "max")]

# Note that nearly all participants reported being fluent in English and almost all of these
# were native English speakers
table(study3datatrimmed$english_native)
table(study3datatrimmed$english)

english <- data.frame(table(study3datatrimmed$english)[c(2,1)])
colnames(english) <- c("English fluency", "Participants")
english$Percentage <- round(english$Participants/sum(english$Participants)*100,1)

edu <- data.frame(table(study3datatrimmed$education)[c(7,6,3,8,1,2,4,5)])
colnames(edu) <- c("Educational Attainment Level", "Participants")
edu$Percentage <- round(edu$Participants/sum(edu$Participants)*100,1)

income <- data.frame(table(study3datatrimmed$income)[c(10,4,7,8,9,1,2,3,5,6,11,12)])
colnames(income) <- c("Household Income", "Participants")
income$Percentage <- round(income$Participants/sum(income$Participants)*100,1)

gender <- data.frame(table(study3datatrimmed$gender))
colnames(gender) <- c("Gender Identity", "Participants")
gender$Percentage <- round(gender$Participants/sum(gender$Participants)*100,1)

@
\end{scriptsize}

Descriptive statistics for the scale scores are shown in the code above. Note that the IRT scores for the CRA items (for both wave 1 and the retest values) range are T-scores based on the IRT parameters from Study 1. The scale scores for FFIS are mean scored, based on the items answered; a subset of the sample was not administered the FFIS items due to an complication in the coding of the survey administration (some participants' response sessions timed out before they got to the FFIS section). Internal consistencies for the FFIS scales and the Cognitive Reflection Task, reported in Table \ref{tab:reliabilities}, were all above threshold.


