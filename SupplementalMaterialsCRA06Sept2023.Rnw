<<Study1.22, eval=TRUE, echo=FALSE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 
cor_obj = CRAvalidityData %>% 
  # grab only numeric variables
  dplyr::select(where(is.numeric)) %>%
  # run cor test on data frame
  corr.test()

cor_obj_df = cor_obj$ci %>% #extract CI obj from list
  #make data frame
  as.data.frame() %>% 
  # add new column called vars containing row names -- these are the names of the variables
  mutate(vars = rownames(.)) %>%
  # select only rows with CRAni in them  (CRA items)
  dplyr::filter(str_detect(vars, "CRAni")) %>% 
  # remove this part of the string -- we already know it's a correlation with CRA
  mutate(vars = str_remove(vars, "-CRAni")) %>% 
  # remove age, RID, and the CRAT correlations
  dplyr::filter(!(vars %in% c("RID", "age")))

# based on order of variables in above object, what do we want the real labels to be?

cor_CRA_CRAT <- cor_obj_df["CRAni-CRATi",]
# drop the CRA_CRAT row
cor_obj_df <- cor_obj_df[!(row.names(cor_obj_df) %in% "CRAni-CRATi"),]

ylabels <- c("Agreeableness", "Conscientiousness", "Neuroticism", "Extraversion", "Openness",
             "Impulsivity", "Adaptability", "Self-Control", "Compassion", "Creativity",
             "Charisma", "Perfectionism", "Conformity", "Order", "Emotional Stability",
             "Irritability", "Emotional Expressiveness", "Intellect", "Humor", "Sociability",
             "Conservatism", "Art Appreciation", "Authoritarianism", "Trust", "Honesty",
             "Attention-Seeking", "Well-Being", "Sensation-Seeking", "Introspection",
             "Anxiety", "Industry", "Easy-Goingness", "Letter-Number Series", "Matrix Reasoning",
             "Rotation:3D", "Verbal Reasoning", "Figural Analogies", "Propositional Reasoning")

# add names -- this ONLY WORKS if the order of ylabels matches the order of the variables in the data frame EXACTLY
names(ylabels) = cor_obj_df$vars

cor_obj_df %>% 
  # modify variables
  mutate( 
    # create group variable -- this is based on the order of the variables in the data frame so be careful
    group = c(
      rep("Big Five", 5),
      rep("SPI-27", 27),
      rep("ICAR", 6)),
    # specifying this is a factor so it keeps this exact order in the figure, instead of alphabetical order
    group = factor(group, levels = c("Big Five", "SPI-27", "ICAR"))) %>% 
  # recode variable labels with the ones we wrote out above
  mutate(vars = recode(vars, !!!ylabels) )%>% 
  ## remove Big Five traits (if you want)
  #dplyr::filter(group != "Big Five") %>%
  # plotting time!!
  ggplot(aes(
    # make the variables go on the x-axis -- we'll rotate later but need numbers on y for the CIs
    x = reorder(vars, r),  #reorder makes the traits go from most + to most - correlated, within group
    y = r)) +  # y = correlation
  # a horizontal (after rotated:vertical) line here 
  geom_hline(aes(yintercept = 0), linetype = "dashed", color = "grey")  +
  # confidence intervals
  geom_errorbar(aes(ymin = lower, ymax = upper), width = .5) + 
  # add points for the correlations
  geom_point() + 
  #switch x and y -- this makes the correlations go down, rather than across
  coord_flip() + 
  # get rid of x-axis label (which shows up on the y-axis bc rotation)
  labs(x = NULL) + 
  # facet  grid will break these into cute little boxes
  # note that this function doesn't care about the coord_flip -- we actually mean X and Y here
  facet_grid(
    #rows defined by groups, no variable for columns
    group ~., 
    # allows each box to take up the space it needs, rather than evenly dividing the plot into 2 or 3 boxes
    space = "free_y", 
    # allows each y-axis to be different 
    scales = "free_y") +
  # change theme 
  # i like this one bc it has boxes to separate the three sections, keeps the grid lines so it's easier to see see which
  # point goes with which trait/correlation value, and is mainly white
  theme_bw()
  ggsave(filename = paste(wdpath, "figure/validityCors.png", sep=""), scale = 1, width = 5, height = 6, units = c("in"), dpi = 300)

@
\end{scriptsize}

\begin{figure}
\begin{center}
\includegraphics[width=.95\textwidth]{figure/validityCors.png}\caption{Correlation with the new CRA items}\label{fig:validityCors}
\end{center}
\end{figure}

Once the scales are scored and organized, identifying the point estimates of the correlations and the 95\% confidence intervals is straight-forward. Figure \ref{fig:validityCors} shows the correlations between the new CRA items and the SPI Big Five, SPI-27, and ICAR measures. The results in Figure \ref{fig:validityCors} are mostly consistent with past findings on the relationship between measures of creativity and various other individual differences. As hypothesized, some of the stronger relationships emerged between associative ability and traits related to Openness to Experience. Among the SPI traits, associative ability showed the strongest positive correlation with Intellect, and some of the strongest negative associations with Conservatism (-) and Conformity (-). Unexpectedly, the relationship between associative ability and self-reported Creativity was relatively weak. For the Big Five traits, Openness to Experience showed one of the stronger relationships to associative ability, but the strongest relationship was found with Agreeableness. This was another unexpected finding, as was the relatively strong relationship between associative ability and SPI Honesty, which is closely related to the broader trait of Agreeableness. 

In line with previous findings, traits related to emotionality also showed some of the stronger relationships with Associative Ability. For the SPI traits, Associative Ability showed some of the strongest positive relationships with Emotional Expressiveness, Well-Being, and Emotional Stability, and some of the strongest negative relationships with Anxiety, Impulsivity, and Irritability. Associative Ability also showed one of the strongest negative relationships with Big Five Neuroticism.

Associative Ability was more strongly related to the ICAR cognitive abilities than to the temperament traits assessed using the SPI. This could be because the CRA items and cognitive ability measures are both performance-based rather than self-report measures (i.e., the measurement of these constructs introduces shared method variance). Associative Ability showed the strongest relationship with Propositional Reasoning and a relatively strong relationship with Verbal Reasoning. As expected, Associative ability showed weaker relationships with Figural Analogies, Spatial Ability (3D rotation), and Matrix Reasoning. Note that the correlations among the new CRA items and the CRAT items (not shown in the table) were higher than those with the other ICAR item types. The point estimate was \Sexpr{round(cor_CRA_CRAT$r,2)} [95\% CI: \Sexpr{round(cor_CRA_CRAT$lower,2)},\Sexpr{round(cor_CRA_CRAT$upper,2)}].

\begin{scriptsize}
<<Study1.22A, eval=TRUE, echo=TRUE, results='hide', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 

### Code for running partial correlations ####  
  
# Selecting variables needed for g factor scores
  data <- CRAvalidityData %>%
    dplyr::select(RID, c(`Letter-Number Series`:`Propositional Reasoning`)) %>%
    clean_names() %>% # cleaning up column names
    dplyr::rename(RID=rid)
  
 
  # Fit measurement model
gFactor_model <- '
gFactor =~ `letter_number_series` + `matrix_reasoning` + rotation3d + `verbal_reasoning` + `figural_analogies` +
            `propositional_reasoning`
'                   
  
gFactor_fit <- suppressWarnings(cfa(gFactor_model, # model
                     data = data, # data
                     std.lv = TRUE,
                     missing= "ML"))  # standardize variance of gFactor
  
  # Scoring on the general factor
  gFactor_scores <- lavPredict(object = gFactor_fit,  
                               type = "lv",                 # factor scores
                               method = "regression")       # use regression 
 
  # Add latent g scores to dataset
  data <- cbind(data, gFactor_scores)

  # Add to CRAvalidityData file
  CRAvalidityData <- CRAvalidityData %>%
    dplyr::inner_join(data[,c(1,8)], by = "RID")
  
  # t-scoring g factor variable to match others
  CRAvalidityData <- CRAvalidityData %>%
    dplyr::mutate(gFactor=((gFactor-mean(gFactor, na.rm=T))/sd(gFactor, na.rm=T))*10+50) 
    
  # Running Partial correlations
  SPI_pCor_vars <- CRAvalidityData %>%
    dplyr::mutate(`CRA new items`=((`CRA new items`-mean(`CRA new items`, na.rm=T))/sd(`CRA new items`, na.rm=T))*10+50) %>% 
    dplyr::select(Agreeableness:EasyGoingness, `CRA new items`, gFactor)
  
  # Running partial correlations
  SPI_pCors <- partial.r(SPI_pCor_vars, c(1:33), 34)
  
@
\end{scriptsize}


\begin{scriptsize}
<<Study1.22B, eval=TRUE, echo=FALSE, results='markup', fig.show='hide', tidy=FALSE, message=FALSE, warning=FALSE>>= 

   # Getting orignal correlations for comparison
  original_cors <- data.frame(round(cor_obj$r[c(3:34),41],2)) %>%
    setNames("r") %>%
    mutate(Trait = rownames(.)) %>%
    relocate(Trait)
  
  # Confidence intervals for partial correlations
  
  # Need to get the minimum number of pairwise admins for CRA items and gfactor with all other scales 
  pwiseAdminsScales <- pairwiseCount(SPI_pCor_vars, diagonal = TRUE)
  pwiseAdminsScales <- data.frame(pwiseAdminsScales)
  pwiseAdminsScales <- pwiseAdminsScales %>% dplyr::select(CRA.new.items, gFactor)
  psych::describe(pwiseAdminsScales$CRA.new.items) # pairwise admins for CRA
  psych::describe(pwiseAdminsScales$gFactor) # Pairwise admins for gFactor
  pwiseAdminsScalesDescribe <- psych::describe(pwiseAdminsScales$CRA.new.items) # CRA has fewer pairwise admins than gFactor
  n_obs <- pwiseAdminsScalesDescribe$min
  n_obs
  
  SPI_pCors_CI <-data.frame(print(corr.p(SPI_pCors,n=n_obs,ci=TRUE), short=FALSE)) %>%
    dplyr::mutate(Trait = rownames(.)) %>%
    relocate(Trait) %>%
    dplyr::filter(grepl("CRA", Trait)) %>%
    dplyr::rename(partial_r = r) %>%
    dplyr::mutate(Trait=original_cors$Trait) %>%
    inner_join(original_cors, by="Trait") %>%
    relocate(r, .after="Trait") %>%
    dplyr::rename(partial_lower = lower,
    partial_upper = upper,
    partial_p = p)
  
  
SPI_pCors_CI %>% 
  dplyr::select(Trait, r, partial_r, partial_p) %>%
  dplyr::mutate(difference = abs(r-partial_r)) %>%
  relocate(difference, .after=partial_r) %>%
  arrange(desc(difference)) 
  
@
\end{scriptsize}


